/datum/unit_test/mod_atrocinator_visuals/Destroy()
	SSticker.current_state = saved_game_state
	return ..()

/datum/unit_test/mod_atrocinator_visuals/Run()
	SSticker.current_state = GAME_STATE_PLAYING
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = make_temporal_suit(user, /obj/item/mod/module/atrocinator)
	var/obj/item/mod/module/atrocinator/module = locate() in mod.modules
	var/matrix/normal = matrix(user.transform)
	TEST_ASSERT(module.on_activation(), "Atrocinator must activate for the visual regression")
	sleep(GRAVITY_INVERSION_TIME)
	var/matrix/inverted = matrix(normal)
	inverted.Scale(1, -1)
	TEST_ASSERT_EQUAL(json_encode(user.transform.tolist()), json_encode(inverted.tolist()), "Atrocinator must flip the actual transform")
	TEST_ASSERT(istype(user.alerts["gravity"], /atom/movable/screen/alert/negative), "Negative gravity must show its own alert instead of high gravity")
	user.refresh_gravity()
	user.update_transform(FALSE)
	TEST_ASSERT_EQUAL(json_encode(user.transform.tolist()), json_encode(inverted.tolist()), "Refreshing gravity and appearance must not flip the wearer back")
	var/mob/living/carbon/human/reference = allocate(/mob/living/carbon/human)
	reference.transform = normal
	user.resize = RESIZE_BIG
	reference.resize = RESIZE_BIG
	user.update_transform(FALSE)
	reference.update_transform(FALSE)
	user.setDir(EAST)
	reference.setDir(EAST)
	user.set_resting(TRUE)
	reference.set_resting(TRUE)
	sleep(GRAVITY_INVERSION_TIME)
	module.on_deactivation()
	sleep(GRAVITY_INVERSION_TIME)
	TEST_ASSERT_EQUAL(json_encode(user.transform.tolist()), json_encode(reference.transform.tolist()), "Turning inversion off after resizing and resting must preserve the normal body transform")
	TEST_ASSERT(!user.gravity_inverted, "Ending inversion after resizing and resting must restore orientation")
	user.update_gravity(STANDARD_GRAVITY)
	TEST_ASSERT_NULL(user.alerts["gravity"], "Normal gravity must clear the inversion alert")
	user.update_gravity(GRAVITY_DAMAGE_TRESHOLD)
	TEST_ASSERT(istype(user.alerts["gravity"], /atom/movable/screen/alert/veryhighgravity), "Crushing gravity must retain its own alert")
	user.update_gravity(NEGATIVE_GRAVITY)
	sleep(GRAVITY_INVERSION_TIME)
	TEST_ASSERT(istype(user.alerts["gravity"], /atom/movable/screen/alert/negative), "Inversion must replace a stale high gravity alert")
	user.update_gravity(FALSE)
	sleep(GRAVITY_INVERSION_TIME)
	TEST_ASSERT(!user.gravity_inverted, "Weightlessness must release visual inversion")
	TEST_ASSERT(istype(user.alerts["gravity"], /atom/movable/screen/alert/weightless), "Weightlessness must retain its own alert")
	user.refresh_gravity()

