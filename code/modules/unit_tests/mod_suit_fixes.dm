/datum/unit_test/mod_dampener_roundtrip/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/projectile_dampener/module = allocate(/obj/item/mod/module/projectile_dampener)
	mod.install(module)
	user.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	var/obj/item/projectile/bullet/bullet = allocate(/obj/item/projectile/bullet)
	bullet.stun = 1 SECONDS
	bullet.knockdown = 1 SECONDS
	bullet.stamina = bullet.damage
	var/list/original = list("damage" = bullet.damage, "pixels_per_second" = bullet.pixels_per_second, "stun" = bullet.stun, "knockdown" = bullet.knockdown, "stamina" = bullet.stamina)
	TEST_ASSERT(module.on_activation(), "Dampener must activate on a powered MOD")
	var/datum/proximity_monitor/advanced/peaceborg_dampener/mod_field/field = module.dampening_field
	TEST_ASSERT(field && bullet in field.tracked, "New field must capture projectiles already inside")
	TEST_ASSERT_EQUAL(bullet.damage, original["damage"] * MOD_DAMPENER_DAMAGE, "Dampener must apply the source damage multiplier")
	TEST_ASSERT_EQUAL(bullet.pixels_per_second, original["pixels_per_second"] * MOD_DAMPENER_SPEED, "Dampener must slow native pixel projectiles")
	TEST_ASSERT_EQUAL(bullet.stun, original["stun"] * MOD_DAMPENER_DEBUFF, "Dampener must weaken stun")
	bullet.forceMove(get_step(user, EAST))
	TEST_ASSERT_EQUAL(bullet.damage, original["damage"] * MOD_DAMPENER_DAMAGE, "Moving inside a field must not multiply effects again")
	bullet.forceMove(locate(user.x + MOD_DAMPENER_RADIUS + 1, user.y, user.z))
	TEST_ASSERT(!(bullet in field.tracked), "Projectile leaving a field must be released")
	for(var/key in original)
		TEST_ASSERT_EQUAL(bullet.vars[key], original[key], "Leaving a field must restore [key]")
	bullet.forceMove(get_turf(user))
	TEST_ASSERT(bullet in field.tracked, "Returning projectile must be captured again")
	var/obj/structure/closet/crate/carrier = allocate(/obj/structure/closet/crate)
	var/turf/start = get_turf(user)
	user.forceMove(carrier)
	carrier.forceMove(locate(start.x + MOD_DAMPENER_RADIUS + 1, start.y, start.z))
	module.on_active_process(1)
	TEST_ASSERT(!(bullet in field.tracked), "Field must follow a wearer moved inside a container")
	TEST_ASSERT_EQUAL(bullet.damage, original["damage"], "Carried field must release projectiles at its old location")
	bullet.forceMove(get_turf(user))
	TEST_ASSERT(bullet in field.tracked, "Carried field must catch projectiles at its new location")
	mod.finish_activation(FALSE)
	TEST_ASSERT(!module.dampening_field && QDELETED(field), "Suit shutdown must delete its field")
	for(var/key in original)
		TEST_ASSERT_EQUAL(bullet.vars[key], original[key], "Shutdown must restore [key]")
	TEST_ASSERT(!HAS_TRAIT(bullet, TRAIT_MOD_DAMPENED), "Shutdown must remove its owned projectile trait")

/datum/unit_test/mod_dampener_overlap_cleanup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/projectile/bullet/bullet = allocate(/obj/item/projectile/bullet)
	var/damage = bullet.damage
	var/speed = bullet.pixels_per_second
	var/datum/proximity_monitor/advanced/peaceborg_dampener/mod_field/first = make_field(/datum/proximity_monitor/advanced/peaceborg_dampener/mod_field, list("host" = user, "current_range" = MOD_DAMPENER_RADIUS))
	var/datum/proximity_monitor/advanced/peaceborg_dampener/mod_field/second = make_field(/datum/proximity_monitor/advanced/peaceborg_dampener/mod_field, list("host" = user, "current_range" = MOD_DAMPENER_RADIUS))
	TEST_ASSERT_EQUAL(bullet.damage, damage * MOD_DAMPENER_DAMAGE * MOD_DAMPENER_DAMAGE, "Overlapping fields must combine")
	qdel(first)
	TEST_ASSERT_EQUAL(bullet.damage, damage * MOD_DAMPENER_DAMAGE, "Removing one field must preserve the other")
	TEST_ASSERT_EQUAL(bullet.pixels_per_second, speed * MOD_DAMPENER_SPEED, "Removing one field must preserve the other slowdown")
	TEST_ASSERT(HAS_TRAIT_FROM(bullet, TRAIT_MOD_DAMPENED, REF(second)), "Remaining field must retain its owned trait")
	user.forceMove(locate(user.x + MOD_DAMPENER_RADIUS + 1, user.y, user.z))
	second.recalculate_field(TRUE)
	TEST_ASSERT_EQUAL(bullet.damage, damage, "Moving a field away must release old projectiles")
	TEST_ASSERT_EQUAL(bullet.pixels_per_second, speed, "Moving a field away must restore projectile speed")
	bullet.forceMove(get_turf(user))
	TEST_ASSERT(bullet in second.tracked, "Moved field must capture new arrivals")
	qdel(bullet)
	TEST_ASSERT(!length(second.tracked), "Deleted projectiles must leave no strong reference in the field")
	qdel(second)

/datum/unit_test/mod_chameleon_roundtrip/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/chameleon/module = allocate(/obj/item/mod/module/chameleon)
	mod.name = "Custom MOD"
