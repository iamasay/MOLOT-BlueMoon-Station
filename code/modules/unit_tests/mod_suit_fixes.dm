/datum/unit_test/mod_capture_roundtrip/Run()
	for(var/module_type in list(/obj/item/mod/module/criminalcapture, /obj/item/mod/module/criminalcapture/patienttransport))
		var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
		var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
		target.forceMove(get_step(user, EAST))
		var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
		var/obj/item/mod/module/criminalcapture/capture = allocate(module_type)
		mod.install(capture)
		user.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
		mod.quick_activation()
		STOP_PROCESSING(SSobj, mod)
		capture.capture_time = 0
		capture.packup_time = 0
		capture.on_activation()
		COOLDOWN_RESET(capture, cooldown_current_timer)
		var/charge_before = mod.get_charge()
		TEST_ASSERT(capture.on_select_use(target), "Capture module must create its bag around an adjacent target")
		var/obj/structure/closet/body_bag/containment/bag = capture.linked_bodybag
		TEST_ASSERT_EQUAL(target.loc, bag, "Created bag must contain its target")
		TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - capture.use_power_cost, "Capture must charge activation energy once")
		var/datum/gas_mixture/air = bag.return_air()
		TEST_ASSERT(air.return_pressure() > ONE_ATMOSPHERE * O2STANDARD, "Capture bag must supply breathable pressure")
		var/datum/gas_mixture/breath = bag.remove_air_ratio(BREATH_VOLUME / MOD_CAPTURE_AIR_VOLUME)
		TEST_ASSERT(breath.total_moles() > 0, "Capture bag must supply a real breath")
		qdel(breath)
		TEST_ASSERT_EQUAL(bag.return_air(), air, "Breathing must reuse the owned atmosphere rather than leaking mixtures")
		breath = bag.handle_internal_lifeform(target, BREATH_VOLUME)
		TEST_ASSERT(breath && breath.total_moles() > 0, "Native life support must draw air from the hardlight bag")
		qdel(breath)
		capture.on_process(1)
		TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - capture.use_power_cost - DEFAULT_CHARGE_DRAIN * MOD_CAPTURE_UPKEEP, "Active bag must consume upkeep power")
		COOLDOWN_RESET(capture, cooldown_current_timer)
		TEST_ASSERT(capture.on_select_use(bag), "Selecting the bag must pack it up")
		TEST_ASSERT_NULL(capture.linked_bodybag, "Packing up must release the bag reference")
		TEST_ASSERT_EQUAL(get_turf(target), get_turf(bag), "Packing up must release the target onto the floor")
		TEST_ASSERT_NOTEQUAL(target.loc, bag, "Packed bag must not retain its target")
		TEST_ASSERT(capture.icon_state in icon_states(capture.icon), "Capture module inventory sprite must exist")
		TEST_ASSERT(bag.icon_state in icon_states(bag.icon), "Hardlight bag sprite must exist")
		qdel(bag)
		TEST_ASSERT_NULL(bag.air_contents, "Deleting bag must release its atmosphere")
		qdel(mod)
		qdel(user)
		qdel(target)

