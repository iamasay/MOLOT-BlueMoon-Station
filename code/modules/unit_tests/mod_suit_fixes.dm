	TEST_ASSERT(!module.assisted_user && !module.idle_power_cost, "Power failure must clear wearer references and idle drain")
	TEST_ASSERT(!HAS_TRAIT_FROM(user, TRAIT_NICE_SHOT, REF(module)), "Power failure must remove sharpshooter effects")
	TEST_ASSERT(!module.set_mode("invalid"), "Configuration must reject unknown modes")

/datum/unit_test/mod_shooting_fire_and_retract/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/shooting_assistant/module = allocate(/obj/item/mod/module/shooting_assistant)
	var/obj/item/gun/ballistic/automatic/pistol/gun = allocate(/obj/item/gun/ballistic/automatic/pistol)
	mod.install(module)
	user.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	module.set_mode(MOD_SHOOT_FAST)
	var/spread = gun.get_mod_spread(user, 0, 0)
	TEST_ASSERT(spread >= MOD_SHOOT_FAST_MIN && spread <= MOD_SHOOT_FAST_MAX, "Native gun fire must receive the stormtrooper spread interval")
	module.set_mode(MOD_SHOOT_PRECISE)
	TEST_ASSERT_EQUAL(gun.get_mod_spread(user, 0, 0), 0, "Sharpshooter must not invert a perfectly accurate gun's spread")
	TEST_ASSERT(gun.get_mod_spread(user, MOD_SHOOT_FAST_MAX, MOD_SHOOT_FAST_MIN) < MOD_SHOOT_FAST_MAX, "Sharpshooter must reduce existing spread")
	var/obj/item/projectile/bullet/projectile = allocate(/obj/item/projectile/bullet)
	projectile.firer = user
	projectile.fired_from = gun
	projectile.fire(0)
	TEST_ASSERT_EQUAL(projectile.ricochets_max, 1, "Fired projectile must gain one additional ricochet")
	TEST_ASSERT_EQUAL(projectile.min_ricochets, 1, "First ricochet must be guaranteed on a suitable surface")
	TEST_ASSERT_EQUAL(projectile.accuracy_falloff, 0, "Sharpshooter projectile must not lose accuracy with distance")
	TEST_ASSERT_EQUAL(projectile.ricochet_incidence_leeway, 0, "Sharpshooter must permit any ricochet angle")
	qdel(projectile)
	var/obj/item/clothing/mod_part/gloves = mod.get_gauntlets()
	mod.conceal(user, gloves, TRUE)
