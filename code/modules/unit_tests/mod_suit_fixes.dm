	TEST_ASSERT(module.set_mode(MOD_SHOOT_PRECISE), "Assistant must switch directly to sharpshooter mode")
	TEST_ASSERT(!HAS_TRAIT_FROM(user, TRAIT_DOUBLE_TAP, REF(module)), "Mode switch must release its old trait")
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_DOUBLE_TAP, INNATE_TRAIT), "Mode switch must preserve another source of rapid trigger")
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_NICE_SHOT, REF(module)), "Sharpshooter must use the native ricochet targeting trait")
