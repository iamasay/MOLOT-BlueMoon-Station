#define PROTEAN_HEARING_TEST_RANGE 2

/datum/unit_test/protean_folded_hearing_occlusion
	var/grid_ready

/datum/unit_test/protean_folded_hearing_occlusion/New()
	..()
	grid_ready = SSspatial_grid.initialized

/datum/unit_test/protean_folded_hearing_occlusion/Destroy()
	SSspatial_grid.initialized = grid_ready
	return ..()

/datum/unit_test/protean_folded_hearing_occlusion/Run()
	TEST_ASSERT(grid_ready, "Spatial grid must be available for the hearing regression")
	var/turf/origin = run_loc_floor_bottom_left
	var/turf/barrier = get_step(origin, EAST)
	var/turf/destination = get_step(barrier, EAST)
	TEST_ASSERT_NOTNULL(destination, "Hearing fixture must have room for a listener behind a wall")
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, destination)
	user.set_species(/datum/species/protean)
	var/obj/item/organ/brain/protean/brain = user.getorganslot(ORGAN_SLOT_BRAIN)
	brain.transform_delay = 0
	brain.transform_animation = 0
	brain.go_into_suit()
	sleep(world.tick_lag)
	TEST_ASSERT(user in GLOB.protean_listeners, "Fixture must use a real folded Protean")
	var/obj/effect/hearer_contents_test_listener/ordinary = allocate(/obj/effect/hearer_contents_test_listener, get_turf(user))
	for(var/use_legacy in list(FALSE, TRUE))
		check_hearing(user, ordinary, origin, TRUE, use_legacy)
		TEST_ASSERT(!(user in query_hearers(0, origin, use_legacy)), "Radius zero must exclude a folded Protean on another turf")
		TEST_ASSERT(user in query_hearers(0, get_turf(user), use_legacy), "Radius zero must include the folded Protean on the source turf")
		var/obj/effect/spatial_grid_test_wall/wall = allocate(/obj/effect/spatial_grid_test_wall, barrier)
		check_hearing(user, ordinary, origin, FALSE, use_legacy)
		qdel(wall)
		check_hearing(user, ordinary, origin, TRUE, use_legacy)
	TEST_ASSERT(!(user in get_hearers_in_view(PROTEAN_HEARING_TEST_RANGE, origin, SPATIAL_GRID_CONTENTS_TYPE_CLIENTS)), "Speech forwarding must not add a clientless Protean to the sound client channel")
	for(var/mob/oranges_ear/ear as anything in SSspatial_grid.pregenerated_oranges_ears)
		TEST_ASSERT_NULL(ear.loc, "Protean hearing queries must release their temporary ears")

/datum/unit_test/protean_folded_hearing_occlusion/proc/query_hearers(distance, turf/origin, use_legacy)
	SSspatial_grid.initialized = !use_legacy
	. = get_hearers_in_view(distance, origin)
	SSspatial_grid.initialized = grid_ready

/datum/unit_test/protean_folded_hearing_occlusion/proc/check_hearing(mob/living/user, atom/movable/ordinary, turf/origin, expected, use_legacy)
	var/list/listeners = query_hearers(PROTEAN_HEARING_TEST_RANGE, origin, use_legacy)
	TEST_ASSERT_EQUAL((ordinary in listeners), expected, "Ordinary listener must follow native visibility with legacy=[use_legacy]")
	TEST_ASSERT_EQUAL((user in listeners), expected, "Folded Protean must follow the same visibility with legacy=[use_legacy]")
	var/count = 0
	for(var/atom/movable/listener as anything in listeners)
		if(listener == user)
			count++
	TEST_ASSERT_EQUAL(count, expected ? 1 : 0, "A folded Protean must receive each speech query at most once")

#undef PROTEAN_HEARING_TEST_RANGE

