	TEST_ASSERT_EQUAL(suit.wearer, human, "Loadout must preserve MOD wearer tracking")
	TEST_ASSERT_EQUAL(backpack.loc, suit, "The selected loadout backpack must be preserved in MOD storage")
	TEST_ASSERT_EQUAL(backpack.name, "personal loadout backpack", "Loadout backpack customization must survive")
	TEST_ASSERT_EQUAL(personal_tool.loc, backpack, "Loadout backpack contents must survive")
	TEST_ASSERT_EQUAL(job_tool.loc, suit, "Loadout must preserve existing MOD cargo")
	TEST_ASSERT(HAS_TRAIT(suit, TRAIT_NODROP), "Loadout must preserve the integrated MOD removal restriction")

/datum/unit_test/protean_loadout_before_outfit/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	var/list/modules = suit.modules.Copy()
	var/obj/item/storage/backpack/backpack = allocate(/obj/item/storage/backpack)
	var/obj/item/crowbar/tool = allocate(/obj/item/crowbar, backpack)
	TEST_ASSERT(SSjob.store_protean_loadout(human, backpack, ITEM_SLOT_BACK), "Loadout before job gear must preserve the integrated MOD")
	var/datum/outfit/outfit = new
	outfit.back = /obj/item/storage/backpack
	outfit.backpack_contents = list(/obj/item/screwdriver = 1)
	human.equipOutfit(outfit)
	qdel(outfit)
	TEST_ASSERT_EQUAL(human.back, suit, "Job gear after loadout must restore the same integrated MOD")
	TEST_ASSERT_EQUAL(get_protean_modsuit(human), suit, "Outfit must not replace the linked integrated MOD")
	TEST_ASSERT_EQUAL(backpack.loc, suit, "Job gear must preserve the earlier loadout backpack")
	TEST_ASSERT_EQUAL(tool.loc, backpack, "Job gear must preserve nested loadout contents")
	TEST_ASSERT(locate(/obj/item/screwdriver) in suit, "Job gear contents must be added alongside loadout contents")
	TEST_ASSERT_EQUAL(length(suit.modules), length(modules), "Outfit must not duplicate or discard integrated modules")
	for(var/obj/item/mod/module/module as anything in modules)
		TEST_ASSERT_EQUAL(module.mod, suit, "Outfit must preserve installed module identities")

/datum/unit_test/protean_loadout_slot_guards/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/storage/backpack/backpack = allocate(/obj/item/storage/backpack)
	var/atom/old_location = backpack.loc
	TEST_ASSERT(!SSjob.store_protean_loadout(human, backpack, ITEM_SLOT_BACK), "Other species must keep ordinary loadout behavior")
	TEST_ASSERT_EQUAL(backpack.loc, old_location, "Rejected handling must leave the loadout item untouched")
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	TEST_ASSERT(!SSjob.store_protean_loadout(human, backpack, ITEM_SLOT_HANDS), "Protean hand loadout must keep ordinary equip behavior")
	TEST_ASSERT(!SSjob.store_protean_loadout(human, suit, ITEM_SLOT_BACK), "Loadout must never insert the integrated MOD into itself")
	var/obj/item/mod/module/storage/storage = locate() in suit.modules
	suit.uninstall(storage)
	TEST_ASSERT(SSjob.store_protean_loadout(human, backpack, ITEM_SLOT_BACK), "Missing storage must not allow loadout to displace the integrated MOD")
	TEST_ASSERT_EQUAL(human.back, suit, "Integrated MOD must remain on the back even without storage")
	TEST_ASSERT_EQUAL(backpack.loc, suit, "Missing storage must not destroy the selected backpack")
	suit.drop_suit()
	var/obj/item/storage/backpack/other = allocate(/obj/item/storage/backpack)
	TEST_ASSERT(!SSjob.store_protean_loadout(human, other, ITEM_SLOT_BACK), "Detached integrated MOD must not capture loadout from elsewhere")

/datum/unit_test/mod_link_portrait/Run()
	check_modlink_portrait(/obj/item/mod/control/pre_equipped)

/datum/unit_test/mod_scryer_portrait/Run()
	check_modlink_portrait(/obj/item/clothing/neck/link_scryer/loaded)

/datum/unit_test/proc/check_modlink_portrait(device_type)
	var/mob/living/carbon/human/sender = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/receiver = allocate(/mob/living/carbon/human)
	sender.set_species(/datum/species/human)
	sender.setDir(SOUTH)
	sender.hair_style = "Long Hair 1"
	sender.hair_color = copytext(COLOR_RED, 2)
	sender.update_hair()
	TEST_ASSERT(length(sender.overlays_standing[HAIR_LAYER]), "Portrait fixture must have real visible hair")
	var/obj/item/caller_device = allocate(device_type)
	var/obj/item/receiver_device = allocate(device_type)
	var/slot = istype(caller_device, /obj/item/mod/control) ? ITEM_SLOT_BACK : ITEM_SLOT_NECK
	sender.equip_to_slot_if_possible(caller_device, slot)
	receiver.equip_to_slot_if_possible(receiver_device, slot)
	var/datum/mod_link/caller_link
	var/datum/mod_link/receiver_link
	if(istype(caller_device, /obj/item/mod/control))
		var/obj/item/mod/control/caller_mod = caller_device
		var/obj/item/mod/control/receiver_mod = receiver_device
		caller_link = caller_mod.mod_link
		receiver_link = receiver_mod.mod_link
	else
		var/obj/item/clothing/neck/link_scryer/caller_scryer = caller_device
		var/obj/item/clothing/neck/link_scryer/receiver_scryer = receiver_device
		caller_link = caller_scryer.mod_link
		receiver_link = receiver_scryer.mod_link
	var/datum/mod_link_call/session = new(caller_link, receiver_link)
	var/obj/effect/overlay/modlink/display = caller_link.visual
	TEST_ASSERT(display && display in receiver.vis_contents, "Call must display the caller on the receiver")
	animate(display, alpha = 255, time = 0)
	var/icon/red_portrait = getFlatIcon(display, no_anim = TRUE)
	var/icon/body = getFlatIcon(sender, no_anim = TRUE)
	var/icon/mask = icon('icons/effects/modlink.dmi', "modlink_filter", SOUTH, 1)
	TEST_ASSERT_EQUAL(red_portrait.Width(), body.Width(), "Portrait must preserve the caller width")
	TEST_ASSERT_EQUAL(red_portrait.Height(), body.Height(), "Portrait must preserve the caller height")
	var/visible_body = FALSE
	for(var/pixel_x in 1 to mask.Width())
		for(var/pixel_y in 1 to mask.Height())
			if(mask.GetPixel(pixel_x, pixel_y) && body.GetPixel(pixel_x, pixel_y) && red_portrait.GetPixel(pixel_x, pixel_y) == body.GetPixel(pixel_x, pixel_y))
				visible_body = TRUE
	TEST_ASSERT(visible_body, "Static background must not cover the caller inside the portrait mask")
	sender.hair_color = copytext(COLOR_BLUE, 2)
	sender.update_hair()
	var/update_deadline = world.time + 1 SECONDS
	while(caller_link.appearance_timer && world.time < update_deadline)
		sleep(world.tick_lag)
	TEST_ASSERT_NULL(caller_link.appearance_timer, "Hair change must finish the scheduled portrait refresh")
	TEST_ASSERT(session && caller_link.visual == display, "Changing hair must preserve the existing call and projection")
	var/icon/blue_portrait = getFlatIcon(display, no_anim = TRUE)
	var/icon/blue_body = getFlatIcon(sender, no_anim = TRUE)
	var/output_prefix = "[GLOB.log_directory]/[istype(caller_device, /obj/item/mod/control) ? "mod" : "scryer"]_link"
	fcopy(red_portrait, "[output_prefix]_red_portrait.png")
	fcopy(blue_portrait, "[output_prefix]_blue_portrait.png")
	fcopy(body, "[output_prefix]_red_body.png")
	fcopy(blue_body, "[output_prefix]_blue_body.png")
	var/visible_hair = FALSE
	var/changed_hair = FALSE
	for(var/pixel_x in 1 to mask.Width())
		for(var/pixel_y in 1 to mask.Height())
			if(!mask.GetPixel(pixel_x, pixel_y))
				continue
			if(body.GetPixel(pixel_x, pixel_y) != blue_body.GetPixel(pixel_x, pixel_y))
				changed_hair = TRUE
			if(red_portrait.GetPixel(pixel_x, pixel_y) != blue_portrait.GetPixel(pixel_x, pixel_y))
				visible_hair = TRUE
	TEST_ASSERT(changed_hair, "Fixture hair change must affect the real caller inside the portrait mask")
	TEST_ASSERT(visible_hair, "Changing real hair color during a call must change visible portrait pixels")
	qdel(session)
