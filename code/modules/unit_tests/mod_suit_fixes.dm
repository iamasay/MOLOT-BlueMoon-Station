	TEST_ASSERT_EQUAL(module.assisted_user, user, "Redeploying gloves must restore the selected mode")
	qdel(module)
	TEST_ASSERT(!HAS_TRAIT(user, TRAIT_NICE_SHOT), "Deleting the assistant must remove all owned traits")

/datum/unit_test/mod_weapon_recall_and_cleanup/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/weapon_recall/module = allocate(/obj/item/mod/module/weapon_recall)
	var/obj/item/energy_katana/weapon = allocate(/obj/item/energy_katana)
	weapon.block_chance = 0
	mod.install(module)
	user.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_NOGUNS, REF(module)), "Active recall gloves must forbid gun use")
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_MOD_TOSS_GUN, REF(module)), "Active recall gloves must strengthen thrown guns")
	user.put_in_hands(weapon)
	COOLDOWN_RESET(module, cooldown_current_timer)
	TEST_ASSERT(module.on_use(), "Recall module must bind a held katana")
	TEST_ASSERT_EQUAL(module.linked_weapon, weapon, "Bound katana must be remembered")
	user.dropItemToGround(weapon)
	weapon.forceMove(locate(user.x + MOD_SONAR_SLICES + 1, user.y, user.z))
	COOLDOWN_RESET(module, cooldown_current_timer)
	var/distance = get_dist(user, weapon)
	var/charge = mod.get_charge()
	TEST_ASSERT(module.on_use(), "Distant katana must teleport back")
	TEST_ASSERT(user.is_holding(weapon), "Recalled katana must arrive in a free hand")
	TEST_ASSERT_EQUAL(mod.get_charge(), charge - module.use_power_cost * distance, "Distant recall must consume energy per tile exactly once")
	user.dropItemToGround(weapon)
	weapon.forceMove(get_step(user, EAST))
	var/damage = user.getBruteLoss()
	weapon.throw_impact(user, null)
	TEST_ASSERT(user.is_holding(weapon), "Incoming linked katana must be caught")
	TEST_ASSERT_EQUAL(user.getBruteLoss(), damage, "Catching a katana must prevent impact damage")
	var/obj/item/clothing/mod_part/gloves = mod.get_gauntlets()
	mod.conceal(user, gloves, TRUE)
	TEST_ASSERT(!HAS_TRAIT(user, TRAIT_NOGUNS), "Retracted gloves must restore gun use")
	mod.deploy(user, gloves)
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_NOGUNS, REF(module)), "Redeployed gloves must reapply the restriction")
	qdel(module)
	TEST_ASSERT(!QDELETED(weapon), "Removing a recall module must not delete its borrowed weapon")
	TEST_ASSERT(!HAS_TRAIT(user, TRAIT_NOGUNS), "Deleting recall module must remove its traits")

