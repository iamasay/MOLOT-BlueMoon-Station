/datum/unit_test/mod_atrocinator_lifecycle/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/passenger = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = make_temporal_suit(user, /obj/item/mod/module/atrocinator)
	var/obj/item/mod/module/atrocinator/module = locate() in mod.modules
	var/base_gravity = user.has_gravity()
	TEST_ASSERT(module.on_activation(), "Atrocinator must activate on a powered suit")
	TEST_ASSERT_EQUAL(user.has_gravity(), NEGATIVE_GRAVITY, "Atrocinator must reverse its wearer's gravity")
	TEST_ASSERT(user.gravity_inverted, "Atrocinator must visually invert its wearer")
	var/list/speech = list("Test", null, list())
	SEND_SIGNAL(user, COMSIG_MOB_SAY, speech)
	TEST_ASSERT("upside_down" in speech[SPEECH_SPANS], "Active atrocinator must invert speech")
	var/rendered = user.compose_message(user, user.get_selected_language(), speech[SPEECH_MESSAGE], null, speech[SPEECH_SPANS])
	TEST_ASSERT(findtext(rendered, "upside_down"), "Rendered speech must retain the inverted text style")
	TEST_ASSERT(HAS_TRAIT_FROM(user, TRAIT_MOD_INVERTED, REF(module)), "Active inversion must block buckling")
	TEST_ASSERT(!user.buckle_mob(passenger, TRUE, FALSE), "An inverted wearer cannot carry a passenger")
	TEST_ASSERT(!passenger.buckle_mob(user, TRUE, FALSE), "An inverted wearer cannot be buckled")
	mod.finish_activation(FALSE)
	TEST_ASSERT_NULL(module.inverted_user, "Suit shutdown must release the module's wearer reference")
	TEST_ASSERT(!HAS_TRAIT(user, TRAIT_MOD_INVERTED), "Suit shutdown must restore buckling")
	TEST_ASSERT(!HAS_TRAIT_FROM(user, TRAIT_SILENT_STEP, REF(module)), "Suit shutdown must restore footsteps")
	TEST_ASSERT_EQUAL(user.has_gravity(), base_gravity, "Suit shutdown must remove owned negative gravity")
	TEST_ASSERT(!user.gravity_inverted, "Suit shutdown must restore the wearer's visual orientation")
	speech = list("Test", null, list())
	SEND_SIGNAL(user, COMSIG_MOB_SAY, speech)
	TEST_ASSERT(!("upside_down" in speech[SPEECH_SPANS]), "Suit shutdown must restore normal speech")
	TEST_ASSERT(passenger.buckle_mob(user, TRUE, FALSE), "Buckling must work again after shutdown")

