/datum/unit_test/mod_kinesis_movement_and_release/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = make_temporal_suit(user, /obj/item/mod/module/anomaly_locked/kinesis/prebuilt)
	var/obj/item/mod/module/anomaly_locked/kinesis/module = locate() in mod.modules
	var/obj/item/screwdriver/tool = allocate(/obj/item/screwdriver, get_step(user, EAST))
	TEST_ASSERT(module.on_activation(), "Prebuilt kinesis must activate with its gravitational core")
	COOLDOWN_RESET(module, cooldown_current_timer)
	var/charge = mod.get_charge()
	TEST_ASSERT(module.on_select_use(tool), "The actual module target action must grab a nearby item")
	TEST_ASSERT_EQUAL(mod.get_charge(), charge - module.use_power_cost, "Kinesis must charge once for a successful grab")
	TEST_ASSERT(HAS_TRAIT_FROM(tool, TRAIT_NO_FLOATING_ANIM, REF(module)), "Grabbed item must suspend its floating animation")
	TEST_ASSERT(module.move_grab(get_turf(user)), "Kinesis must move an item toward its wearer")
	TEST_ASSERT(user.is_holding(tool), "Moving an item to the wearer must actually put it in hand")
	TEST_ASSERT_NULL(module.grabbed_atom, "Picking up a kinesis item must release the grab")
	TEST_ASSERT_NULL(module.kinesis_beam, "Releasing the item must delete its beam")
	TEST_ASSERT(!HAS_TRAIT_FROM(tool, TRAIT_NO_FLOATING_ANIM, REF(module)), "Released items must regain normal animation")
	var/obj/item/screwdriver/other = allocate(/obj/item/screwdriver, get_step(user, EAST))
	TEST_ASSERT(module.grab_atom(other), "Kinesis must accept another item after a pickup")
	other.set_anchored(TRUE)
	TEST_ASSERT_NULL(module.grabbed_atom, "Anchoring the target must release it immediately")
	other.set_anchored(FALSE)
	TEST_ASSERT(module.grab_atom(other), "Unanchored target must become usable again")
	qdel(other)
	TEST_ASSERT_NULL(module.grabbed_atom, "Deleting a grabbed target must release its stored reference")
	TEST_ASSERT_NULL(module.kinesis_beam, "Deleting a grabbed target must release its beam")
	var/obj/item/screwdriver/last = allocate(/obj/item/screwdriver, get_step(user, EAST))
	TEST_ASSERT(module.grab_atom(last), "Kinesis must remain usable after deleting its target")
	qdel(module.kinesis_beam)
	TEST_ASSERT_NULL(module.grabbed_atom, "Losing the beam must release its target")
	TEST_ASSERT_NULL(module.kinesis_beam, "Losing the beam must release its stored reference")
	TEST_ASSERT(!HAS_TRAIT_FROM(last, TRAIT_NO_FLOATING_ANIM, REF(module)), "Losing the beam must restore its target's animation")

