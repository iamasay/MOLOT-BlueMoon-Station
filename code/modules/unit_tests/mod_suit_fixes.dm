	TEST_ASSERT(!suit.get_cell(), "Protean MOD must not create a battery")
	var/obj/item/organ/stomach/protean/stomach = human.getorganslot(ORGAN_SLOT_STOMACH)
	TEST_ASSERT(istype(stomach), "Protean must have a refactory")
	stomach.metal = PROTEAN_STOMACH_FULL
