	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	hydraulic.on_activation()
	TEST_ASSERT(hydraulic.icon_state in icon_states(hydraulic.icon), "Hydraulic arms must have an inventory icon")
	TEST_ASSERT(hydraulic.overlay_state_active in icon_states(hydraulic.overlay_icon_file), "Hydraulic arms must have a worn overlay")
