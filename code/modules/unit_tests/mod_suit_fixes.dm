	for(var/key in module.visual_vars)
		original[key] = mod.vars[key]
	TEST_ASSERT(module.set_disguise(/obj/item/storage/backpack), "Inactive MOD must accept a valid backpack disguise")
	var/obj/item/storage/backpack/disguise_type = /obj/item/storage/backpack
	TEST_ASSERT_EQUAL(mod.icon, initial(disguise_type.icon), "Disguise must replace the inventory sprite")
