/datum/unit_test/protean_folded_death_repair/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	var/obj/item/organ/brain/protean/brain = human.getorganslot(ORGAN_SLOT_BRAIN)
	brain.transform_delay = 0
	brain.transform_animation = 0
	brain.go_into_suit()
	sleep(world.tick_lag)
	var/datum/action/protean/transform/transform = locate() in human.actions
	human.death()
	TEST_ASSERT(!suit.check_charge(DEFAULT_CHARGE_DRAIN), "A dead folded Protean must immediately stop supplying power")
	TEST_ASSERT(!transform.IsAvailable(), "Death must immediately disable reforming before the retreat timer runs")
	var/deadline = world.time + 2 SECONDS
	while(!brain.dead && world.time < deadline)
		sleep(world.tick_lag)
	TEST_ASSERT(brain.dead && human.loc == suit, "Death inside MOD must still enter the emergency repair state")
	TEST_ASSERT_NULL(human.getorganslot(ORGAN_SLOT_STOMACH), "Death inside MOD must consume the fragile refactory")
	var/obj/item/organ/stomach/protean/stomach = allocate(/obj/item/organ/stomach/protean)
	stomach.Insert(human, TRUE)
	brain.revive()
	TEST_ASSERT(!brain.dead && human.stat != DEAD && human.loc == suit, "A replacement refactory must repair death inside MOD")
	brain.leave_modsuit()
	sleep(world.tick_lag)
	TEST_ASSERT_EQUAL(human.back, suit, "Repaired Protean must be able to reform normally")

/datum/unit_test/protean_servo_brain_removal/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/protean/suit = make_protean_servo_suit(human, wearer)
	TEST_ASSERT(suit, "Servo fixture must activate on another wearer")
	var/obj/item/mod/module/protean_servo/servo = locate() in suit.modules
	var/datum/action/cooldown/protean_servo/medical/medical = locate() in servo.servo_actions
	TEST_ASSERT(medical.Trigger(), "Folded Protean must start its medical boost")
	var/obj/item/organ/brain/protean/brain = human.getorganslot(ORGAN_SLOT_BRAIN)
	brain.Remove(TRUE)
	TEST_ASSERT(!servo.active, "Removing the Protean brain must stop its servo module immediately")
	TEST_ASSERT(!wearer.has_status_effect(/datum/status_effect/protean_servo_medical), "Brain removal must clear the external wearer's boost")
	TEST_ASSERT_NULL(servo.servo_wearer_ref, "Stopping servo must release its remembered wearer")
	for(var/datum/action/cooldown/protean_servo/ability as anything in servo.servo_actions)
		TEST_ASSERT_NULL(ability.owner, "Brain removal must revoke servo buttons")
	brain.Insert(human, TRUE)
	TEST_ASSERT_EQUAL(human.remote_control, suit, "Reinserting the core into a folded body must restore MOD movement control")
	TEST_ASSERT(human.IsStun(), "Reinserting the core into a folded body must preserve its folded stun")
	TEST_ASSERT(HAS_TRAIT_FROM(human, TRAIT_RESISTLOWPRESSURE, PROTEAN_TRAIT), "Reinserting the core must restore folded environment protection")
	TEST_ASSERT(servo.on_activation(), "A reinserted core must be able to reactivate servo")

/datum/unit_test/protean_servo_reform_cleanup/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/protean/suit = make_protean_servo_suit(human, wearer)
	TEST_ASSERT(suit, "Servo fixture must activate")
	var/obj/item/mod/module/protean_servo/servo = locate() in suit.modules
	var/datum/action/cooldown/protean_servo/movement/movement = locate() in servo.servo_actions
	var/obj/item/screwdriver/tool = allocate(/obj/item/screwdriver)
	wearer.put_in_active_hand(tool)
	TEST_ASSERT(wearer.is_holding(tool), "Servo fixture must hold a tool before enabling movement")
	TEST_ASSERT(movement.Trigger(), "Servo movement boost must activate")
	TEST_ASSERT(HAS_TRAIT_FROM(tool, TRAIT_NODROP, PROTEAN_SERVO_TRAIT), "Movement boost must secure the held tool")
	var/obj/item/organ/brain/protean/brain = human.getorganslot(ORGAN_SLOT_BRAIN)
	brain.leave_modsuit()
	sleep(world.tick_lag)
	TEST_ASSERT(!servo.active, "Reforming must deactivate servo")
	TEST_ASSERT(!HAS_TRAIT_FROM(wearer, TRAIT_RESTRAINED, PROTEAN_SERVO_TRAIT), "Reforming must release the previous wearer's hands")
	TEST_ASSERT(!HAS_TRAIT_FROM(tool, TRAIT_NODROP, PROTEAN_SERVO_TRAIT), "Reforming must release held tools")
	TEST_ASSERT(wearer.dropItemToGround(tool), "The previous wearer must be able to drop tools after the boost ends")
	TEST_ASSERT_NULL(movement.owner, "Reforming must revoke the servo action")
	TEST_ASSERT_EQUAL(human.back, suit, "Reforming must return the MOD to its Protean")

/datum/unit_test/protean_core_releases_deleted_body/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/protean/suit = make_protean_servo_suit(human, wearer)
	TEST_ASSERT(suit, "Servo fixture must activate")
	var/obj/item/mod/core/protean/core = suit.core
	var/obj/item/mod/module/protean_servo/servo = locate() in suit.modules
	var/datum/action/cooldown/protean_servo/engineering/engineering = locate() in servo.servo_actions
	TEST_ASSERT(engineering.Trigger(), "Engineering boost must activate before deleting its Protean")
	qdel(human)
	TEST_ASSERT(!QDELETED(suit), "Deleting the folded body must leave the external wearer's MOD intact")
	TEST_ASSERT_NULL(core.linked_protean, "Core must not retain a deleted Protean body")
	TEST_ASSERT(!core.check_charge(DEFAULT_CHARGE_DRAIN), "Core without a body must not supply power")
	TEST_ASSERT(!suit.is_active() && !servo.active, "Deleting the Protean must stop MOD and servo")
	for(var/obj/item/clothing/mod_part/part as anything in suit.get_mod_parts(include_cell = FALSE))
		TEST_ASSERT(!(part.clothing_flags & part.visor_flags), "Deleting the Protean must unseal its unpowered MOD parts")
		TEST_ASSERT(!part.heat_protection && !part.cold_protection, "Deleting the Protean must clear active temperature protection")
	TEST_ASSERT(!wearer.has_status_effect(/datum/status_effect/protean_servo_engineer), "Deleting the Protean must remove its engineering boost")
	TEST_ASSERT_NULL(engineering.owner, "Deleting the Protean must release servo action ownership")

/datum/unit_test/protean_servo_remembers_buff_owner/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/other = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/protean/suit = make_protean_servo_suit(human, wearer)
	TEST_ASSERT(suit, "Servo fixture must activate")
