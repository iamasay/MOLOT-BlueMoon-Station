	event = mood.mood_events[MOD_DEMORALIZER_MOOD]
	TEST_ASSERT_EQUAL(event.mood_change, MOD_DEMORALIZER_ANTAG_MOOD, "Antagonists must receive source +1 mood")
	TEST_ASSERT(event.hidden && event.timeout == 2 MINUTES, "Psi-echo mood must keep source duration and hidden status")

