	other.install(storage)
	human.put_in_active_hand(other)
	TEST_ASSERT(suit.assimilate_modsuit(human, other), "Fixture must absorb another storage module")
	qdel(native_storage)
	TEST_ASSERT(!length(suit.cached_modules), "Deleted cached modules must be removed from the owning list")
	TEST_ASSERT(suit.unassimilate_modsuit(human, TRUE), "Deleting cached storage must not prevent extracting the donor")
	TEST_ASSERT_EQUAL(storage.mod, other, "Extraction must return surviving storage to the donor")

/datum/unit_test/protean_forced_exit_cleanup/Run()
