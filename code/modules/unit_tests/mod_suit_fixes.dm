/datum/unit_test/mod_ash_accretion_movement/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/ash_accretion/ash = allocate(/obj/item/mod/module/ash_accretion)
	mod.install(ash)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	var/obj/item/clothing/mod_part/suit/chest = mod.get_chestplate()
	var/base_melee = chest.get_armor().getRating(MELEE)
	var/turf/normal = get_turf(human)
	var/turf/left = get_step(normal, WEST)
	var/turf/right = get_step(normal, EAST)
	var/left_type = left.type
	var/right_type = right.type
	left = left.ChangeTurf(/turf/open/floor/plating/asteroid)
	right = right.ChangeTurf(/turf/open/floor/plating/asteroid)
	for(var/step in 1 to MOD_ASH_MAX_LAYERS)
		human.forceMove(step % 2 ? left : right)
	TEST_ASSERT_EQUAL(ash.layers, MOD_ASH_MAX_LAYERS, "Travel over asteroid ground must accumulate full protection")
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(MELEE), base_melee + MOD_ASH_MAX_LAYERS * MOD_ASH_MELEE, "Each traveled tile must add exactly one armor layer")
	TEST_ASSERT_EQUAL(ash.get_slowdown(), MOD_ASH_SLOWDOWN, "Full ash must grant its speed bonus")
	human.forceMove(left)
	TEST_ASSERT_EQUAL(ash.layers, MOD_ASH_MAX_LAYERS, "Ash must not exceed its maximum")
	human.forceMove(normal)
	TEST_ASSERT_EQUAL(ash.layers, MOD_ASH_MAX_LAYERS - 1, "Standard floor must shed one ash layer per move")
	TEST_ASSERT_EQUAL(ash.get_slowdown(), 0, "Losing one layer must remove the full-cover speed bonus")
	mod.finish_activation(FALSE)
	TEST_ASSERT_EQUAL(ash.layers, 0, "Deactivation must remove all ash")
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(MELEE), base_melee, "Deactivation must restore base armor exactly")
	left.ChangeTurf(left_type)
	right.ChangeTurf(right_type)

