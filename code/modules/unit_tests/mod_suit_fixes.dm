/datum/unit_test/mod_remote_commands_and_cleanup/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/operator = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped/standard)
