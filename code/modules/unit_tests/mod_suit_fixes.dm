	TEST_ASSERT(program.activate(), "Holocaller must project into an empty neck slot")
	var/obj/item/clothing/neck/link_scryer/scryer = program.linked_scryer
	TEST_ASSERT_EQUAL(human.wear_neck, scryer, "Holocaller must be wearable")
	var/obj/item/stock_parts/cell/cell = scryer.cell
	scryer.AltClick(human)
	TEST_ASSERT_EQUAL(scryer.cell, cell, "NIF holocaller must not expose an infinite battery")
