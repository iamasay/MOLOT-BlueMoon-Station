	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/magnet/magnet = allocate(/obj/item/mod/module/magnet)
	var/obj/structure/closet/locker = allocate(/obj/structure/closet)
	locker.forceMove(get_step(human, EAST))
	mod.install(magnet)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	magnet.on_activation()
	TEST_ASSERT(magnet.icon_state in icon_states(magnet.icon), "Loader magnet must have an inventory icon")
	TEST_ASSERT(magnet.overlay_state_active in icon_states(magnet.overlay_icon_file), "Loader magnet must have its worn overlay")
	TEST_ASSERT(magnet.catch_locker(WEAKREF(locker), WEAKREF(human), magnet.pull_cycle), "Magnet must catch a nearby locker")
	TEST_ASSERT_EQUAL(human.pulling, locker, "Caught locker must be pulled by the wearer")
	TEST_ASSERT(!locker.can_open(other), "Magnetic grip must stop other users opening the locker")
	TEST_ASSERT(locker.can_open(human), "Magnetic grip must permit its owner to open the locker")
	human.stop_pulling()
	TEST_ASSERT_NULL(magnet.held_locker, "Stopping pull must release the tracked locker")
	TEST_ASSERT_NULL(magnet.grip_user, "Stopping pull must release the tracked wearer")
	TEST_ASSERT(!HAS_TRAIT(locker, TRAIT_STRONGPULL), "Stopping pull must release the magnetic grip")
	TEST_ASSERT(locker.can_open(other), "Released locker must open normally")
	magnet.catch_locker(WEAKREF(locker), WEAKREF(human), magnet.pull_cycle)
	qdel(magnet)
	TEST_ASSERT_NULL(human.pulling, "Deleting magnet must release its pull")
	TEST_ASSERT(!QDELETED(locker) && !HAS_TRAIT(locker, TRAIT_STRONGPULL), "Deleting magnet must preserve and unlock the locker")

