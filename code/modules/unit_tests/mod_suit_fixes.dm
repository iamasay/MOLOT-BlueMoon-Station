	var/obj/item/organ/stomach/protean/stomach = allocate(/obj/item/organ/stomach/protean)
	stomach.Insert(human, TRUE)
	brain.revive()
	TEST_ASSERT(!brain.dead && human.stat != DEAD, "Repair must revive the protean")
	TEST_ASSERT(human.loc == suit, "Repair must leave the protean inside its MOD")
	human.set_species(/datum/species/human)
	TEST_ASSERT(isturf(human.loc), "Changing species inside the MOD must eject its occupant")
	TEST_ASSERT(!human.IsStun(), "Changing species must clear the protean's folded stun")

