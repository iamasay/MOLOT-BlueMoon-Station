	human.death()
	sleep(PROTEAN_TRANSFORM_ANIMATION + 1 SECONDS)
	TEST_ASSERT(brain.dead && human.loc == suit, "Death must retreat the protean into its MOD")
	TEST_ASSERT(!human.getorganslot(ORGAN_SLOT_STOMACH), "Emergency retreat must destroy the fragile refactory")
	var/brute = human.getBruteLoss()
	human.apply_damage(PROTEAN_FEED_HEAL, BRUTE)
