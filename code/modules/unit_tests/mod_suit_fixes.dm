// Регрессы по багрепортам на МОД от 17.07.2026. Тесты названы по симптому,
// который видел игрок, а не по внутреннему механизму.

// "Перетаскивание сумки на мод не работает - вещи выпадают на пол"
//
// Хранилище МОД получает компонентом, а типом остаётся обычным /obj/item.
// get_dumping_location() у /obj отдаёт турф, и вся сумка уезжала на пол вместо
// отсеков костюма: правом на "меня можно наполнить" владел только тип
// /obj/item/storage, хотя storage_contents_dump_act() рядом уже давно
// диспатчится по наличию компонента.
/datum/unit_test/mod_storage_accepts_dumped_container/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/mod/module/storage/module = allocate(/obj/item/mod/module/storage)
	mod.install(module)

	TEST_ASSERT_NOTNULL(mod.GetComponent(/datum/component/storage), \
		"test premise: installing the storage module must give the MOD a storage component")
	TEST_ASSERT_EQUAL(mod.get_dumping_location(), mod, \
		"A MOD with a storage module must swallow a dumped container itself instead of spilling it on the floor")

	// обратная сторона: костюм без модуля обязан остаться "неналивным"
	var/obj/item/mod/control/bare = allocate(/obj/item/mod/control)
	TEST_ASSERT_EQUAL(bare.get_dumping_location(), get_turf(bare), \
		"A MOD without a storage module must keep dumping onto the floor")

// "Вытащил модуль хранилища - вещи остались в моде, но без доступа к ним"
//
// on_uninstall() убивал компонент, ничего не выгрузив: предметы так и лежали
// в contents костюма, а UI к ним больше не открывался.
/datum/unit_test/mod_storage_module_releases_contents/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/mod/module/storage/module = allocate(/obj/item/mod/module/storage)
	mod.install(module)

	var/datum/component/storage/storage = mod.GetComponent(/datum/component/storage)
	TEST_ASSERT_NOTNULL(storage, "test premise: installing the storage module must give the MOD a storage component")

	var/obj/item/stored = allocate(/obj/item/screwdriver)
	TEST_ASSERT(storage.handle_item_insertion(stored, TRUE), "test premise: the item must fit into the MOD storage")
	TEST_ASSERT_EQUAL(stored.loc, mod, "test premise: an inserted item must actually live inside the MOD")

	mod.uninstall(module)

	TEST_ASSERT_NOTEQUAL(stored.loc, mod, \
		"Pulling the storage module must not strand items inside the MOD with no way to reach them")
	TEST_ASSERT_NULL(mod.GetComponent(/datum/component/storage), \
		"Pulling the storage module must take the storage component with it")

// "Рампартка на надетых частях ломает изоляцию МОДа - поддувает и замерзаешь"
//
// Набор брони присваивал (не сливал) восемь защитных переменных с прототипа
// жилета. Запечатывание костюма восстанавливает только clothing_flags через
// visor_flags, поэтому min_cold_protection_temperature и body_parts_covered
// оставались жилетными навсегда.
/datum/unit_test/armor_kit_refuses_mod_parts/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/clothing/mod_part/suit/chestplate = mod.mod_parts[MOD_PART_CHEST]
	TEST_ASSERT_NOTNULL(chestplate, "test premise: a MOD must build itself a chestplate")

	var/covered_before = chestplate.body_parts_covered
	var/flags_before = chestplate.clothing_flags
	var/cold_before = chestplate.min_cold_protection_temperature

	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/armorkit/durathread/vest/kit = allocate(/obj/item/armorkit/durathread/vest)
	kit.afterattack(chestplate, user, TRUE)

	TEST_ASSERT(!chestplate.reinforced, "An armor kit must not reinforce a MOD part")
	TEST_ASSERT_EQUAL(chestplate.body_parts_covered, covered_before, \
		"An armor kit must not shrink the coverage of a MOD part")
	TEST_ASSERT_EQUAL(chestplate.clothing_flags, flags_before, \
		"An armor kit must not strip the clothing flags of a MOD part")
	TEST_ASSERT_EQUAL(chestplate.min_cold_protection_temperature, cold_before, \
		"An armor kit must not strip the cold protection of a MOD part - sealing only restores clothing_flags")
	TEST_ASSERT(!QDELETED(kit), "An armor kit rejected by a MOD part must not be consumed")

// Регресс по раунду 10137: части МОДа составляли 44 харддела из 127 за смену -
// половину всего бюджета заморозки от SSgarbage (15.0 с из 29.6 с).
//
// mod_parts это alist с числовыми ключами MOD_PART_*, а вычитание из alist идёт
// ПО КЛЮЧУ. Destroy() костюма передавал в `mod_parts -= ...` саму часть, то есть
// значение, и не удалял ничего: alist продолжал держать уже qdel-нутую часть, та
// проваливала окно GC и уходила в харддел. Батарея в лог хардделов не попадала
// только потому, что её чистил QDEL_NULL(MOD_CELL) - этот макрос разворачивается
// в mod_parts[MOD_PART_CELL] и работает как lvalue.
/datum/unit_test/mod_destroy_releases_its_parts/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/list/parts = mod.get_mod_parts(include_cell = FALSE)
	TEST_ASSERT(length(parts), "test premise: a MOD must build itself some parts")

	qdel(mod)

	for(var/obj/item/clothing/mod_part/part as anything in parts)
		TEST_ASSERT(QDELETED(part), \
			"Destroying a MOD must actually destroy [part.type], not just detach it")
		TEST_ASSERT(!mod.is_mod_part(part), \
			"A destroyed MOD must not keep holding [part.type] in mod_parts - that reference is what sent every part to hard delete")

// Пин на семантику alist: именно она сломала Destroy выше. Если однажды alist
// начнёт вычитать по значению, этот тест упадёт и правку можно будет упростить.
/datum/unit_test/mod_parts_are_keyed_not_valued/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/clothing/mod_part/head/helmet = mod.mod_parts[MOD_PART_HEAD]
	TEST_ASSERT_NOTNULL(helmet, "test premise: a MOD must build itself a helmet")

	mod.mod_parts -= helmet
	TEST_ASSERT(mod.is_mod_part(helmet), \
		"Subtracting a part by value must stay a no-op on an alist - if this changed, revisit /obj/item/mod/control/Destroy")

	TEST_ASSERT(mod.clear_mod_part(helmet), "clear_mod_part must report that it found the part")
	TEST_ASSERT(!mod.is_mod_part(helmet), "clear_mod_part must actually drop the part out of mod_parts")
	TEST_ASSERT(!mod.clear_mod_part(helmet), "clear_mod_part must report a miss the second time round")
	// Отцепленный шлем костюм при своём qdel уже не увидит - убираем сами, иначе тест
	// оставляет в нулевом пространстве шлем с mod на удалённый костюм (ровно тот
	// харддел, ради которого он написан).
	qdel(helmet)

// Перебор alist отдаёт КЛЮЧИ, поэтому `for(var/obj/item/part in mod_parts)` молча
// не исполнялся ни разу: фильтр по типу отбрасывал числа. На этом стояли проверка
// "выдвиньте элементы МОДа", сокрытие частей при обыске и пружинная ловушка.
/datum/unit_test/mod_part_iteration_yields_parts/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)

	var/naive_hits = 0
	for(var/obj/item/part in mod.mod_parts)
		naive_hits++
	TEST_ASSERT_EQUAL(naive_hits, 0, \
		"test premise: iterating the alist directly must keep yielding keys, not parts")

	var/list/parts = mod.get_mod_parts(include_cell = FALSE)
	TEST_ASSERT(length(parts), "get_mod_parts must return the actual parts")
	for(var/part in parts)
		TEST_ASSERT(istype(part, /obj/item/clothing/mod_part), \
			"get_mod_parts must return parts, got [part]")

// Обычная одежда обязана и дальше укрепляться - фикс не должен убить сам механизм.
/datum/unit_test/armor_kit_still_reinforces_clothing/Run()
	var/obj/item/clothing/suit/hooded/wintercoat/coat = allocate(/obj/item/clothing/suit/hooded/wintercoat)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/armorkit/durathread/vest/kit = allocate(/obj/item/armorkit/durathread/vest)

	kit.afterattack(coat, user, TRUE)

	TEST_ASSERT(coat.reinforced, "An armor kit must still reinforce ordinary outer clothing")

/// Модуль longfall гасит урон от падения, пока костюм включён, и не гасит после выключения.
/datum/unit_test/mod_longfall_cancels_fall_damage/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/pre_equipped/standard/mod = allocate(/obj/item/mod/control/pre_equipped/standard)
	var/obj/item/mod/module/longfall/module = allocate(/obj/item/mod/module/longfall)
	mod.install(module)
	mod.wearer = wearer
	module.on_suit_activation()

	wearer.ZImpactDamage(get_turf(wearer), 1)
	TEST_ASSERT_EQUAL(wearer.getBruteLoss(), 0, "A fall with an active longfall module must deal no damage")

	module.on_suit_deactivation()
	wearer.ZImpactDamage(get_turf(wearer), 1)
	TEST_ASSERT(wearer.getBruteLoss() > 0, "A fall after the suit is off must hurt again")
	mod.wearer = null

/datum/unit_test/mod_armor_survives_activation/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	wearer.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	var/obj/item/clothing/mod_part/chest = mod.get_chestplate()
	var/base_rating = chest.get_armor().getRating(BULLET)
	var/obj/item/mod/module/armor/plate = allocate(/obj/item/mod/module/armor/prebuild/bullet)
	mod.install(plate)
	var/bonus = plate.armor_bonus
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(BULLET), base_rating + bonus, "Installed plate must add armor")
	mod.need_to_conseal += "ears"
	mod.finish_activation(TRUE)
	mod.update_hardlight()
	wearer.regenerate_icons()
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(BULLET), base_rating + bonus, "Activation and hardlight must preserve plate armor")
	mod.finish_activation(FALSE)
	mod.uninstall(plate)
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(BULLET), base_rating, "Removal must restore baseline without negative armor")

/datum/unit_test/mod_rejects_active_installation/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/mod/module/armor/plate = allocate(/obj/item/mod/module/armor/prebuild/bullet)
	mod.toggle_state(MOD_ACTIVE)
	mod.install(plate)
	TEST_ASSERT(!(plate in mod.modules), "Active MOD must reject plates")
	mod.toggle_state(MOD_ACTIVE)
	mod.toggle_state(MOD_ACTIVATING)
	mod.install(plate)
	TEST_ASSERT(!(plate in mod.modules), "Transitioning MOD must reject plates")
	mod.toggle_state(MOD_ACTIVATING)
	mod.install(plate)
	TEST_ASSERT(plate in mod.modules, "Inactive MOD must accept plates")
	var/total_slowdown = 0
	for(var/obj/item/part in mod.get_mod_parts(include_cell = FALSE))
		total_slowdown += part.slowdown
	TEST_ASSERT_EQUAL(total_slowdown, mod.slowdown_inactive, "Armor weight must immediately reach the clothing")

/datum/unit_test/mod_speed_potion_survives_activation/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	wearer.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	var/obj/item/mod/module/armor/plate = allocate(/obj/item/mod/module/armor/prebuild/bullet)
	mod.install(plate)
	var/obj/item/slimepotion/speed/potion = allocate(/obj/item/slimepotion/speed)
	mod.handle_slimepotion_effect(potion, wearer)
	mod.finish_activation(TRUE)
	mod.finish_activation(FALSE)
	mod.uninstall(plate)
	for(var/obj/item/part in mod.get_mod_parts(include_cell = FALSE))
		TEST_ASSERT_EQUAL(part.slowdown, 0, "Potion must survive activation and armor changes")
	TEST_ASSERT(QDELETED(potion), "One potion must be consumed")

/datum/unit_test/mod_storage_upgrade_order/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/obj/item/mod/module/storage_upgrader/upgrade = allocate(/obj/item/mod/module/storage_upgrader)
	var/obj/item/mod/module/storage/storage = allocate(/obj/item/mod/module/storage)
	mod.install(upgrade)
	mod.install(storage)
	var/datum/component/storage/container = mod.GetComponent(/datum/component/storage)
	var/obj/item/bulky = allocate(/obj/item)
	bulky.w_class = MAX_WEIGHT_CLASS_BAG_OF_HOLDING
	TEST_ASSERT(container.handle_item_insertion(bulky, TRUE), "Upgrade must accept bag-of-holding sized objects even when installed before storage")
	mod.uninstall(upgrade)
	TEST_ASSERT_EQUAL(container.max_w_class, storage.max_w_class, "Removing upgrade must restore the storage limit")
	mod.install(upgrade)
	mod.uninstall(storage)
	TEST_ASSERT_NOTEQUAL(bulky.loc, mod, "Removing upgraded storage must release its contents")
	mod.install(storage)
	TEST_ASSERT_EQUAL(storage.mod_storage.max_w_class, MAX_WEIGHT_CLASS_BAG_OF_HOLDING, "Reinstalled storage must retain the upgrade")

/datum/unit_test/mod_gps_keeps_suit_name/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/old_name = mod.name
	var/obj/item/mod/module/gps/module = allocate(/obj/item/mod/module/gps)
	mod.install(module)
	TEST_ASSERT_EQUAL(mod.name, old_name, "GPS installation must preserve the theme name")
	TEST_ASSERT_EQUAL(module.internal_gps.gpstag, "MODsuit GPS", "GPS must keep its own tag")
	mod.uninstall(module)
	TEST_ASSERT_EQUAL(mod.name, old_name, "GPS removal must preserve the theme name")

/datum/unit_test/mod_hot_swap_theme/Run()
	var/obj/item/mod/control/civilian = allocate(/obj/item/mod/control)
	var/obj/item/mod/control/antag = allocate(/obj/item/mod/control, null, /datum/mod_theme/antagonist)
	civilian.toggle_state(MOD_ACTIVE)
	antag.toggle_state(MOD_ACTIVE)
	TEST_ASSERT(!civilian.can_replace_cell(), "Civilian MOD must forbid hot swaps")
	TEST_ASSERT(antag.can_replace_cell(), "Antagonist MOD must allow hot swaps")
	antag.toggle_state(MOD_ACTIVATING)
	TEST_ASSERT(!antag.can_replace_cell(), "A transition must block even antagonist hot swaps")
	antag.toggle_state(MOD_ACTIVATING)
	antag.toggle_state(MOD_ACTIVE)
	civilian.toggle_state(MOD_ACTIVE)

/datum/unit_test/mod_pin_targets_module/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	wearer.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	var/obj/item/mod/module/flashlight/module = allocate(/obj/item/mod/module/flashlight)
	mod.install(module)
	TEST_ASSERT(mod.generate_ability_button(module), "Module must be pinnable")
	TEST_ASSERT(!mod.generate_ability_button(module), "Duplicate pins must be rejected")
	var/datum/action/cooldown/module_action/action = locate() in wearer.actions
	TEST_ASSERT_EQUAL(action.target, module, "Pin must target the module")
	action.Trigger(TRIGGER_RIGHT_CLICK)
	TEST_ASSERT(QDELETED(action), "Right click must delete the pinned action")

/datum/unit_test/mod_store_resolves_unselected_contents/Run()
	var/obj/machinery/suit_storage_unit/industrial/store = allocate(/obj/machinery/suit_storage_unit/industrial)
	var/obj/item/suit = store.suit
	var/obj/item/mod = store.mod
	TEST_ASSERT(suit && mod && store.pending_suit_choice, "Mapped store must start with a choice")
	store.dump_contents()
	TEST_ASSERT(QDELETED(suit), "Unselected dump must discard the alternative suit")
	TEST_ASSERT(!QDELETED(mod) && mod.loc != store, "Unselected dump must release one MOD")
	qdel(mod)

/datum/unit_test/mod_melatonin_icon_states/Run()
	var/obj/item/mod/control/pre_equipped/melatonin/mod = allocate(/obj/item/mod/control/pre_equipped/melatonin)
	for(var/obj/item/clothing/mod_part/part in mod.get_mod_parts(include_cell = FALSE))
		TEST_ASSERT(part.icon_state in icon_states(part.icon), "Unsealed inventory sprite must exist: [part.icon_state]")
		part.seal_part(TRUE)
		TEST_ASSERT(part.icon_state in icon_states(part.icon), "Sealed inventory sprite must exist: [part.icon_state]")


/datum/unit_test/mod_antigrav_resumes_after_standing/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/anomaly_locked/antigrav/prebuilt/module = allocate(/obj/item/mod/module/anomaly_locked/antigrav/prebuilt)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	mod.install(module)
	wearer.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.finish_activation(TRUE)
	module.on_activation()
	TEST_ASSERT(module.active, "Antigrav must activate while standing")
	wearer.set_body_position(LYING_DOWN)
	TEST_ASSERT(!module.active && module.resume_on_standing, "Falling must suspend an enabled antigrav")
	wearer.set_body_position(STANDING_UP)
	TEST_ASSERT(module.active && !module.resume_on_standing, "Standing must restore antigrav")
	module.on_deactivation()
	wearer.set_body_position(LYING_DOWN)
	wearer.set_body_position(STANDING_UP)
	TEST_ASSERT(!module.active, "Standing must not enable a manually disabled antigrav")
	module.on_activation()
	wearer.set_body_position(LYING_DOWN)
	mod.finish_activation(FALSE)
	wearer.set_body_position(STANDING_UP)
	TEST_ASSERT(!module.active && !module.resume_on_standing, "Powering down must cancel pending restoration")

/datum/unit_test/mod_radiation_is_idempotent/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/rad_protection/module = allocate(/obj/item/mod/module/rad_protection)
	var/obj/item/clothing/mod_part/chest = mod.get_chestplate()
	var/rating = chest.get_armor().getRating(RAD)
	mod.install(module)
	module.on_suit_activation()
	module.on_suit_activation()
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(RAD), rating + MOD_RADIATION_BONUS, "Repeated activation must not accumulate radiation armor")
	module.on_suit_deactivation()
	module.on_suit_deactivation()
	TEST_ASSERT_EQUAL(chest.get_armor().getRating(RAD), rating, "Repeated deactivation must not subtract base armor")

/datum/unit_test/mod_holster_hotbar/Run()
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/holster/module = allocate(/obj/item/mod/module/holster)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/gun/energy/laser/gun = allocate(/obj/item/gun/energy/laser)
	mod.install(module)
	wearer.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	wearer.put_in_active_hand(gun)
	mod.generate_ability_button(module)
	var/datum/action/cooldown/module_action/action = locate() in wearer.actions
	action.Trigger()
	TEST_ASSERT_EQUAL(module.holstered, gun, "Pinned holster must store the held gun")
	COOLDOWN_RESET(module, cooldown_current_timer)
	action.next_use_time = 0
	action.Trigger()
	TEST_ASSERT(wearer.is_holding(gun) && !module.holstered, "Pinned holster must return the stored gun")

/datum/unit_test/mod_retractable_reinstallation/Run()
	var/obj/item/mod/control/first = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/control/second = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/defibrillator/module = allocate(/obj/item/mod/module/defibrillator)
	first.install(module)
	var/obj/item/device = module.device
	var/obj/item/stock_parts/cell/first_cell = first.get_cell()
	first.uninstall(module)
	TEST_ASSERT(!module.my_retract_component, "Uninstall must release the old retractable component")
	TEST_ASSERT(!QDELETED(device), "Uninstall must preserve the module's device")
	second.install(module)
	TEST_ASSERT_EQUAL(module.my_retract_component.my_modsuit, second, "Reinstallation must bind to the new MOD")
	var/obj/item/stock_parts/cell/second_cell = second.get_cell()
	qdel(module)
	TEST_ASSERT(!QDELETED(first_cell) && !QDELETED(second_cell), "Deleting a defibrillator must preserve both MOD batteries")
	TEST_ASSERT(QDELETED(device), "Deleting a module must delete its owned device")

/datum/unit_test/mod_link_cleanup/Run()
	var/obj/item/mod/control/first = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/control/second = allocate(/obj/item/mod/control/pre_equipped)
	var/mob/living/carbon/human/first_user = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/second_user = allocate(/mob/living/carbon/human)
	first_user.equip_to_slot_if_possible(first, ITEM_SLOT_BACK)
	second_user.equip_to_slot_if_possible(second, ITEM_SLOT_BACK)
	first.mod_link.frequency = MODLINK_FREQ_NANOTRASEN
	second.mod_link.frequency = MODLINK_FREQ_NANOTRASEN
	TEST_ASSERT(first.mod_link.can_connect(second.mod_link), "Worn powered MODs on one frequency must connect")
	var/datum/mod_link_call/link_session = new(first.mod_link, second.mod_link)
	TEST_ASSERT(HAS_TRAIT(first_user, TRAIT_MODLINK_CALL) && HAS_TRAIT(second_user, TRAIT_MODLINK_CALL), "Both users must enter the link_session")
	var/obj/effect/overlay/first_visual = first.mod_link.visual
	var/obj/effect/overlay/second_visual = second.mod_link.visual
	TEST_ASSERT(second_visual in first_user.vis_contents, "Remote visual must appear on the first user")
	first.unset_wearer()
	TEST_ASSERT(QDELETED(link_session) && QDELETED(first_visual) && QDELETED(second_visual), "Unequipping must destroy the link_session and both visuals")
	TEST_ASSERT(!first.mod_link.link_call && !second.mod_link.link_call, "Both devices must release the link_session")
	TEST_ASSERT(!HAS_TRAIT(first_user, TRAIT_MODLINK_CALL) && !HAS_TRAIT(second_user, TRAIT_MODLINK_CALL), "Both users must leave the link_session")
	var/old_id = first.mod_link.id
	qdel(first)
	TEST_ASSERT(!GLOB.mod_link_ids[old_id], "Destroyed devices must leave the global registry")

/datum/unit_test/mod_screwdriver_stays_in_hand/Run()
	var/obj/item/mod/control/pre_equipped/standard/mod = allocate(/obj/item/mod/control/pre_equipped/standard)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	var/obj/item/screwdriver/tool = allocate(/obj/item/screwdriver)
