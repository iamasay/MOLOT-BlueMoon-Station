/datum/unit_test/protean_assimilation_roundtrip/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	var/obj/item/mod/control/other = allocate(/obj/item/mod/control/pre_equipped/standard)
	var/obj/item/mod/module/armor/prebuild/bullet/plate = allocate(/obj/item/mod/module/armor/prebuild/bullet)
	other.install(plate)
	var/obj/item/tool = allocate(/obj/item/screwdriver)
	tool.forceMove(suit)
	human.put_in_active_hand(other)
	TEST_ASSERT(suit.assimilate_modsuit(human, other), "Protean must assimilate an inactive MOD")
	TEST_ASSERT(!QDELETED(plate) && plate.mod == suit, "Assimilation must transfer prebuilt armor intact")
	TEST_ASSERT_EQUAL(suit.current_armor_module_installed, 1, "Assimilation must count transferred armor once")
	TEST_ASSERT_EQUAL(suit.stored_modsuit, other, "Assimilation must preserve the original suit")
	TEST_ASSERT_EQUAL(tool.loc, suit, "Assimilation must preserve stored items")
	TEST_ASSERT(suit.unassimilate_modsuit(human, TRUE), "Absorbed MOD must be removable")
	TEST_ASSERT(!suit.stored_modsuit && !QDELETED(other), "Removing the absorbed MOD must preserve it")
	TEST_ASSERT_EQUAL(suit.theme.type, /datum/mod_theme/protean, "Original theme must be restored")
	TEST_ASSERT_EQUAL(tool.loc, suit, "Removing absorbed MOD must preserve stored items")

	TEST_ASSERT(!QDELETED(plate) && plate.mod == other, "Unassimilation must return prebuilt armor intact")
	TEST_ASSERT_EQUAL(other.current_armor_module_installed, 1, "Returned armor must be counted once")
	TEST_ASSERT_EQUAL(suit.current_armor_module_installed, 0, "Protean must release transferred armor accounting")

/datum/unit_test/mod_niflink_lifecycle/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
