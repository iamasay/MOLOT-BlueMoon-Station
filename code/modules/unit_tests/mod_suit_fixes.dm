/datum/unit_test/mod_waddle_lifecycle/Run()
	for(var/ending in list("shutdown", "boots", "uninstall", "module", "suit", "wearer"))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
		var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
		var/obj/item/mod/module/waddle/waddle = allocate(/obj/item/mod/module/waddle)
		mod.install(waddle)
		human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
		mod.quick_activation()
		var/obj/item/clothing/mod_part/boots = mod.get_boots()
		var/datum/component/squeak/step_sound = waddle.step_sound
		TEST_ASSERT(waddle.active, "Waddle must be marked active after automatic startup")
		TEST_ASSERT(HAS_TRAIT_FROM(human, TRAIT_WADDLING, REF(waddle)), "Waddle must own a trait source")
		TEST_ASSERT_NOTNULL(human.GetComponent(/datum/component/waddling), "Startup must grant waddling")
		TEST_ASSERT_NOTNULL(step_sound, "Startup must grant boot sounds")
		var/charge_before = mod.get_charge()
		waddle.on_process(1)
		TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - DEFAULT_CHARGE_DRAIN * MOD_WADDLE_POWER, "Active waddle must retain its power drain")
		waddle.on_activation()
		TEST_ASSERT_EQUAL(waddle.step_sound, step_sound, "Repeated activation must not replace components")
		switch(ending)
			if("shutdown")
				mod.finish_activation(FALSE)
			if("boots")
				mod.conceal(human, boots, TRUE)
			if("uninstall")
				mod.uninstall(waddle)
			if("module")
				qdel(waddle)
			if("suit")
				qdel(mod)
			if("wearer")
				qdel(human)
		TEST_ASSERT(!waddle.active, "[ending] must mark waddle inactive")
		TEST_ASSERT_NULL(waddle.waddle_user, "[ending] must release the wearer reference")
		TEST_ASSERT_NULL(waddle.step_sound, "[ending] must release the sound component")
		TEST_ASSERT(QDELETED(step_sound), "[ending] must delete the owned sound component")
		if(ending != "wearer")
			TEST_ASSERT(!HAS_TRAIT(human, TRAIT_WADDLING), "[ending] must remove the waddle trait")
			TEST_ASSERT_NULL(human.GetComponent(/datum/component/waddling), "[ending] must remove module-only waddling")

/datum/unit_test/mod_waddle_preserves_other_sources/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	ADD_TRAIT(human, TRAIT_WADDLING, TRAIT_SOURCE_UNIT_TESTS)
	var/datum/component/waddling/original_waddle = human.LoadComponent(/datum/component/waddling)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/waddle/waddle = allocate(/obj/item/mod/module/waddle)
	mod.install(waddle)
	var/obj/item/clothing/mod_part/boots = mod.get_boots()
	var/datum/component/squeak/original_sound = boots.AddComponent(/datum/component/squeak)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	TEST_ASSERT_EQUAL(human.GetComponent(/datum/component/waddling), original_waddle, "Module must reuse existing waddling")
	TEST_ASSERT(!QDELETED(original_sound), "Module must preserve an independent boot sound component")
	qdel(waddle)
	TEST_ASSERT(HAS_TRAIT_FROM(human, TRAIT_WADDLING, TRAIT_SOURCE_UNIT_TESTS), "Removing module must preserve an independent trait source")
	TEST_ASSERT_EQUAL(human.GetComponent(/datum/component/waddling), original_waddle, "Removing module must preserve quirk or mutation waddling")
	TEST_ASSERT(!QDELETED(original_sound), "Removing module must preserve independent boot sounds")
	TEST_ASSERT_NULL(boots.GetComponent(/datum/component/squeak/mod_waddle), "Removing module must delete only its own sounds")
	REMOVE_TRAIT(human, TRAIT_WADDLING, TRAIT_SOURCE_UNIT_TESTS)
	qdel(original_waddle)

/datum/unit_test/mod_sonar_detection_and_cleanup/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/active_sonar/sonar = allocate(/obj/item/mod/module/active_sonar)
	mod.install(sonar)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
	target.forceMove(get_step(human, EAST))
	var/mob/living/carbon/human/dead_target = allocate(/mob/living/carbon/human)
	dead_target.stat = DEAD
	var/list/detected = sonar.get_creatures()
	TEST_ASSERT(target in detected, "Sonar must detect a nearby living target")
	TEST_ASSERT(!(human in detected), "Sonar must exclude its wearer")
	TEST_ASSERT(!(dead_target in detected), "Sonar must exclude dead targets")
	target.moveToNullspace()
	TEST_ASSERT(!(target in sonar.get_creatures()), "Sonar must discard a target that left the world")
	target.forceMove(get_step(human, EAST))
	var/turf/obstacle = get_step(target, EAST)
	var/old_type = obstacle.type
	obstacle = obstacle.ChangeTurf(/turf/closed/wall)
	var/turf/behind_wall = get_step(obstacle, EAST)
	target.forceMove(behind_wall)
	TEST_ASSERT(target in sonar.get_creatures(), "Sonar must detect targets behind opaque walls")
	obstacle.ChangeTurf(old_type)
	target.forceMove(get_step(human, EAST))
	var/scanned = 0
	for(var/slice in 1 to MOD_SONAR_SLICES)
		scanned += sonar.scan_creatures(slice)
	TEST_ASSERT_EQUAL(scanned, length(sonar.get_creatures()), "A complete sweep must scan each target exactly once")
	TEST_ASSERT(length(sonar.pings), "A sweep must create pings")
	var/list/pings = sonar.pings.Copy()
	mod.conceal(human, mod.get_helmet(), TRUE)
	sonar.process()
	TEST_ASSERT(!length(sonar.pings), "Retracting the helmet must clear all pings")
	for(var/obj/effect/temp_visual/mod_sonar_ping/ping as anything in pings)
		TEST_ASSERT(QDELETED(ping), "Retracting the helmet must delete ping effects")
	mod.deploy(human, mod.get_helmet())
	sonar.scan_creatures()
	TEST_ASSERT(length(sonar.pings), "Redeploying the helmet must allow scans again")
	mod.uninstall(sonar)
	TEST_ASSERT(!length(sonar.pings), "Uninstall must clear all pings")
	TEST_ASSERT(!(sonar in SSfastprocess.processing), "Uninstall must stop sonar processing")
	TEST_ASSERT(sonar.icon_state in icon_states(sonar.icon), "Sonar inventory sprite must exist")

/datum/unit_test/mod_sonar_ping_tracking/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
	target.forceMove(get_step(human, EAST))
	var/obj/effect/temp_visual/mod_sonar_ping/tracking = allocate(/obj/effect/temp_visual/mod_sonar_ping, get_turf(human), human, target, TRUE)
	var/obj/effect/temp_visual/mod_sonar_ping/stationary = allocate(/obj/effect/temp_visual/mod_sonar_ping, get_turf(human), human, target, FALSE)
	var/start_x = tracking.ping_image.pixel_x
	target.forceMove(get_step(target, EAST))
	TEST_ASSERT_EQUAL(tracking.ping_image.pixel_x, start_x + world.icon_size, "Active ping must follow target movement")
	TEST_ASSERT_EQUAL(stationary.ping_image.pixel_x, start_x, "Passive ping must preserve its detected position")
	human.forceMove(get_step(human, EAST))
	TEST_ASSERT_EQUAL(tracking.ping_image.pixel_x, start_x, "Ping offset must follow wearer movement")
	TEST_ASSERT_EQUAL(stationary.ping_image.pixel_x, start_x - world.icon_size, "Passive ping must stay at its original world position")
	TEST_ASSERT(tracking.ping_image.icon_state in icon_states(tracking.icon), "Active sonar effect sprite must exist")
	TEST_ASSERT(stationary.ping_image.icon_state in icon_states(stationary.icon), "Passive sonar effect sprite must exist")
	qdel(target)
	TEST_ASSERT(QDELETED(tracking) && QDELETED(stationary), "Deleting the target must clear both pings")
	TEST_ASSERT_NULL(tracking.ping_image, "Deleted ping must release its image")
	TEST_ASSERT_NULL(tracking.user_ref, "Deleted ping must release wearer weakref")
	TEST_ASSERT_NULL(tracking.target_ref, "Deleted ping must release target weakref")

/datum/unit_test/mod_sonar_rejects_cancelled_charge/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/active_sonar/sonar = allocate(/obj/item/mod/module/active_sonar)
	mod.install(sonar)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	sonar.charge_time = 1 SECONDS
	var/charge_before = mod.get_charge()
	addtimer(CALLBACK(mod, TYPE_PROC_REF(/obj/item/mod/control, finish_activation), FALSE), 0.5 SECONDS)
	TEST_ASSERT(!sonar.on_use(), "Disabling suit during charge must cancel sonar pulse")
	TEST_ASSERT(!length(sonar.pings), "Cancelled pulse must not create pings")
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before, "Cancelled pulse must not spend activation energy")
	TEST_ASSERT(!(sonar in SSfastprocess.processing), "Disabled suit must stop sonar processing")

/datum/unit_test/protean_emp_organ_damage/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	for(var/slot in list(ORGAN_SLOT_EYES, ORGAN_SLOT_LIVER, ORGAN_SLOT_EARS))
		var/obj/item/organ/organ = human.getorganslot(slot)
		organ.setOrganDamage(0)
		organ.emp_act(PROTEAN_EMP_THRESHOLD)
		TEST_ASSERT_EQUAL(organ.damage, PROTEAN_EMP_HEAVY_DAMAGE, "Heavy EMP must deal source organ damage to [slot]")
		TEST_ASSERT(!(organ.organ_flags & ORGAN_SYNTHETIC_EMP), "Protean organs must not inherit permanent IPC EMP deterioration")
		organ.setOrganDamage(0)
		organ.emp_act(PROTEAN_EMP_THRESHOLD - 1)
		TEST_ASSERT_EQUAL(organ.damage, PROTEAN_EMP_LIGHT_DAMAGE, "Light EMP must deal source organ damage to [slot]")
		RegisterSignal(organ, COMSIG_ATOM_EMP_ACT, PROC_REF(protect_organ))
		organ.emp_act(PROTEAN_EMP_THRESHOLD)
		TEST_ASSERT_EQUAL(organ.damage, PROTEAN_EMP_LIGHT_DAMAGE, "EMP shielding must protect Protean organs")
		UnregisterSignal(organ, COMSIG_ATOM_EMP_ACT)
	var/obj/item/organ/eyes/protean/eyes = human.getorganslot(ORGAN_SLOT_EYES)
	TEST_ASSERT_EQUAL(eyes.maxHealth, STANDARD_ORGAN_THRESHOLD, "Imaging nanites must have the source maximum health")
	var/obj/item/organ/liver/protean/liver = human.getorganslot(ORGAN_SLOT_LIVER)
	TEST_ASSERT(!liver.filterToxins, "Protean catalyst must use source synthetic reagent processing")

/datum/unit_test/protean_emp_organ_damage/proc/protect_organ(datum/source, severity)
	SIGNAL_HANDLER
	return EMP_PROTECT_SELF

/datum/unit_test/protean_repairs_emp_organs/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/organ/brain/protean/brain = human.getorganslot(ORGAN_SLOT_BRAIN)
	var/obj/item/organ/stomach/protean/stomach = human.getorganslot(ORGAN_SLOT_STOMACH)
	stomach.metal = PROTEAN_STOMACH_FULL
	brain.transform_delay = 0
	brain.transform_animation = 0
	brain.rebuild_time = 0
	brain.go_into_suit()
	sleep(world.tick_lag)
	for(var/slot in list(ORGAN_SLOT_EYES, ORGAN_SLOT_LIVER, ORGAN_SLOT_EARS))
		var/obj/item/organ/organ = human.getorganslot(slot)
		while(organ.damage < organ.maxHealth)
			organ.emp_act(PROTEAN_EMP_THRESHOLD)
		TEST_ASSERT(organ.organ_flags & ORGAN_FAILING, "Repeated EMP must be able to disable [slot]")
	TEST_ASSERT(brain.replace_limbs(), "Folded organ repair must succeed after EMP damage")
	TEST_ASSERT_EQUAL(stomach.metal, PROTEAN_STOMACH_FULL - PROTEAN_REBUILD_COST, "Repair must charge its normal metal cost once")
	for(var/slot in list(ORGAN_SLOT_EYES, ORGAN_SLOT_LIVER, ORGAN_SLOT_EARS))
		var/obj/item/organ/organ = human.getorganslot(slot)
		TEST_ASSERT_EQUAL(organ.damage, 0, "Repair must restore damaged [slot]")
		TEST_ASSERT(!(organ.organ_flags & (ORGAN_FAILING | ORGAN_SYNTHETIC_EMP)), "Repaired [slot] must remain functional")

/datum/unit_test/mod_sonar_pulse_and_shutdown/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/active_sonar/sonar = allocate(/obj/item/mod/module/active_sonar)
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human)
	target.forceMove(get_step(human, EAST))
	mod.install(sonar)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	sonar.charge_time = 0
	var/charge_before = mod.get_charge()
	TEST_ASSERT(sonar.on_use(), "Active sonar pulse must work with powered deployed helmet")
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - sonar.use_power_cost, "Pulse must charge activation energy once")
	TEST_ASSERT(length(sonar.pings), "Pulse must create target pings")
	var/list/pings = sonar.pings.Copy()
	TEST_ASSERT(!sonar.on_use(), "Pulse must respect cooldown")
	mod.finish_activation(FALSE)
	TEST_ASSERT(!length(sonar.pings), "Shutdown must clear active pings")
	for(var/obj/effect/temp_visual/mod_sonar_ping/ping as anything in pings)
