	TEST_ASSERT(!remote.send_command(operator, "activate", list()), "Disconnected remote must reject commands")
	mod.install(module)
	qdel(module)
	TEST_ASSERT(!QDELETED(remote) && !remote.module_ref, "Deleting an installed module must leave its loose remote safely disconnected")

