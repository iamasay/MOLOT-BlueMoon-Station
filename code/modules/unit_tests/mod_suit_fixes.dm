	var/datum/action/cooldown/protean_servo/medical/medical = locate() in servo.servo_actions
	TEST_ASSERT(medical.Trigger(), "Medical boost must activate")
	other.apply_status_effect(/datum/status_effect/protean_servo_medical)
	suit.wearer = other
	servo.on_deactivation()
	suit.wearer = wearer
	TEST_ASSERT(!wearer.has_status_effect(/datum/status_effect/protean_servo_medical), "Late cleanup must clear the actual boosted wearer")
	TEST_ASSERT(other.has_status_effect(/datum/status_effect/protean_servo_medical), "Late cleanup must preserve another wearer's independent boost")

/datum/unit_test/protean_assimilation_slot_and_activation/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	var/obj/item/mod/control/belt = allocate(/obj/item/mod/control/pre_equipped/lustwish)
	human.put_in_active_hand(belt)
	TEST_ASSERT(!suit.assimilate_modsuit(human, belt), "Protean must reject belt MODs as in NovaSector")
	TEST_ASSERT(human.is_holding(belt) && !suit.stored_modsuit, "Rejected assimilation must preserve the target in hand")
	human.dropItemToGround(belt)
	var/obj/item/mod/control/other = allocate(/obj/item/mod/control/pre_equipped/standard)
	human.put_in_active_hand(other)
	TEST_ASSERT(suit.assimilate_modsuit(human, other), "Back-slot MOD must remain compatible")
	ENABLE_BITFIELD(suit.status_flags, MOD_ACTIVATING)
	TEST_ASSERT(!suit.unassimilate_modsuit(human), "MOD activation must prevent unassimilating the stored suit")
	TEST_ASSERT_EQUAL(suit.stored_modsuit, other, "Rejected extraction must preserve the absorbed MOD")
	DISABLE_BITFIELD(suit.status_flags, MOD_ACTIVATING)
	TEST_ASSERT(suit.unassimilate_modsuit(human, TRUE), "Extraction must work again after activation finishes")

/datum/unit_test/protean_reform_blocks_activation/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	suit.quick_activation()
	suit.finish_activation(FALSE)
	human.apply_status_effect(/datum/status_effect/protean_low_power_mode/reform)
	TEST_ASSERT(!suit.toggle_activate(human), "Freshly reformed Protean must not start MOD during the NovaSector vulnerability period")
	TEST_ASSERT(!suit.is_active(), "Rejected activation must leave MOD powered off")
	human.remove_status_effect(/datum/status_effect/protean_low_power_mode/reform)
	suit.activation_step_time = 0
	TEST_ASSERT(suit.toggle_activate(human), "MOD must activate normally after reform weakness expires")
	TEST_ASSERT(suit.is_active(), "Completed activation must power the suit")

/datum/unit_test/protean_deleted_absorbed_suit/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
	var/obj/item/mod/module/storage/native_storage = locate() in suit.modules
	var/obj/item/mod/control/other = allocate(/obj/item/mod/control)
	var/obj/item/mod/module/storage/storage = allocate(/obj/item/mod/module/storage)
	var/obj/item/mod/module/flashlight/flashlight = allocate(/obj/item/mod/module/flashlight)
	other.install(storage)
	other.install(flashlight)
	var/obj/item/screwdriver/cargo = allocate(/obj/item/screwdriver)
	cargo.forceMove(suit)
	human.put_in_active_hand(other)
	TEST_ASSERT(suit.assimilate_modsuit(human, other), "Fixture must absorb the donor MOD")
	TEST_ASSERT(native_storage in suit.cached_modules, "Assimilation must cache its original storage")
	qdel(other)
	TEST_ASSERT_NULL(suit.stored_modsuit, "Deleting an absorbed MOD must release its stored reference")
	TEST_ASSERT(!length(suit.cached_modules) && !length(suit.native_modules), "Deleting the donor must clear assimilation bookkeeping")
	TEST_ASSERT_EQUAL(native_storage.loc, get_turf(suit), "Original cached storage must be safely ejected")
	TEST_ASSERT_EQUAL(flashlight.mod, suit, "Deleting the empty donor shell must preserve transferred modules")
	TEST_ASSERT_EQUAL(storage.mod, suit, "Deleting the donor must preserve the current storage")
	TEST_ASSERT_EQUAL(cargo.loc, suit, "Deleting the donor must preserve stored cargo")
	TEST_ASSERT(suit.unassimilate_theme(), "Deleting the donor must not block resetting Protean plating")

/datum/unit_test/protean_deleted_cached_storage/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/mod/control/pre_equipped/protean/suit = get_protean_modsuit(human)
