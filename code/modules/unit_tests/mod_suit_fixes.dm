#define PROTEAN_REGEN_TEST_EPSILON 0.0001

/datum/unit_test/protean_regenerates_corruption/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/organ/stomach/protean/stomach = human.getorganslot(ORGAN_SLOT_STOMACH)
	human.blood_volume = BLOOD_VOLUME_NORMAL
	human.setToxLoss(PROTEAN_REGEN_AMOUNT * 2, toxins_type = TOX_SYSCORRUPT)
	stomach.metal = PROTEAN_STOMACH_FULL
	COOLDOWN_RESET(stomach, damage_delay)
	stomach.handle_metabolism(1)
	TEST_ASSERT_EQUAL(human.getToxLoss(TOX_SYSCORRUPT), PROTEAN_REGEN_AMOUNT, "Regeneration must repair pure system corruption")
	var/expected = PROTEAN_STOMACH_FULL - PROTEAN_STOMACH_FULL / PROTEAN_METABOLISM_RATE * (stomach.metabolism_modifier + PROTEAN_REGEN_COST)
	TEST_ASSERT(abs(stomach.metal - expected) < PROTEAN_REGEN_TEST_EPSILON, "Successful corruption repair must incur one healing surcharge")

/datum/unit_test/protean_regeneration_no_waste/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/organ/stomach/protean/stomach = human.getorganslot(ORGAN_SLOT_STOMACH)
	human.blood_volume = BLOOD_VOLUME_NORMAL
	human.setOxyLoss(PROTEAN_REGEN_AMOUNT, forced = TRUE)
	stomach.metal = PROTEAN_STOMACH_FULL
	stomach.handle_metabolism(1)
	var/base_cost = PROTEAN_STOMACH_FULL / PROTEAN_METABOLISM_RATE * stomach.metabolism_modifier
	TEST_ASSERT(abs(stomach.metal - (PROTEAN_STOMACH_FULL - base_cost)) < PROTEAN_REGEN_TEST_EPSILON, "Unhealable health loss must incur only baseline metabolism")
	TEST_ASSERT_EQUAL(human.getOxyLoss(), PROTEAN_REGEN_AMOUNT, "Regeneration must not clear unrelated damage")
	human.setToxLoss(PROTEAN_REGEN_AMOUNT, toxins_type = TOX_SYSCORRUPT)
	COOLDOWN_START(stomach, damage_delay, PROTEAN_REGEN_TIME + world.tick_lag)
	stomach.metal = PROTEAN_STOMACH_FULL
	stomach.handle_metabolism(1)
	TEST_ASSERT_EQUAL(human.getToxLoss(TOX_SYSCORRUPT), PROTEAN_REGEN_AMOUNT, "Zero recovery factor must not heal corruption")
	TEST_ASSERT(abs(stomach.metal - (PROTEAN_STOMACH_FULL - base_cost)) < PROTEAN_REGEN_TEST_EPSILON, "No actual healing must not incur a healing surcharge")

/datum/unit_test/protean_regeneration_partial_cost/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
