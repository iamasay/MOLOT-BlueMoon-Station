#define PROTEAN_TEST_EPSILON 0.0001

/datum/unit_test/protean_metabolism_rates/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	human.set_species(/datum/species/protean)
	var/obj/item/organ/stomach/protean/stomach = human.getorganslot(ORGAN_SLOT_STOMACH)
	stomach.metal = PROTEAN_STOMACH_FULL
	human.blood_volume = BLOOD_VOLUME_NORMAL - PROTEAN_BLOOD_REGEN_RATE * 2
	stomach.handle_metabolism(1)
	TEST_ASSERT_EQUAL(human.blood_volume, BLOOD_VOLUME_NORMAL - PROTEAN_BLOOD_REGEN_RATE, "Blood regeneration must use the original NovaSector rate")
	var/expected_metal = PROTEAN_STOMACH_FULL - PROTEAN_STOMACH_FULL / PROTEAN_METABOLISM_RATE * (stomach.metabolism_modifier + PROTEAN_BLOOD_COST)
	TEST_ASSERT(abs(stomach.metal - expected_metal) < PROTEAN_TEST_EPSILON, "Blood regeneration must spend the original amount of metal")
	human.blood_volume = BLOOD_VOLUME_NORMAL
	human.adjustBruteLoss(PROTEAN_REGEN_AMOUNT * 2, forced = TRUE, only_organic = FALSE)
	COOLDOWN_START(stomach, damage_delay, PROTEAN_REGEN_TIME / 2)
	stomach.metal = PROTEAN_STOMACH_FULL
	var/brute_before = human.getBruteLoss()
	stomach.handle_metabolism(1)
	expected_metal = PROTEAN_STOMACH_FULL - PROTEAN_STOMACH_FULL / PROTEAN_METABOLISM_RATE * (stomach.metabolism_modifier + PROTEAN_REGEN_COST / 2)
	TEST_ASSERT(abs(stomach.metal - expected_metal) < PROTEAN_TEST_EPSILON, "Damage cooldown must scale healing cost without reducing baseline metabolism")
	TEST_ASSERT(abs(human.getBruteLoss() - (brute_before - PROTEAN_REGEN_AMOUNT / 2)) < PROTEAN_TEST_EPSILON, "Half recovery cooldown must allow half healing")
	stomach.metal = PROTEAN_STOMACH_FALTERING
	stomach.handle_metabolism(1)
	TEST_ASSERT(LAZYACCESS(human.movespeed_modification, "[/datum/movespeed_modifier/protean_starvation]"), "Starvation must slow the Protean")
	stomach.Remove(special = TRUE)
	TEST_ASSERT(!LAZYACCESS(human.movespeed_modification, "[/datum/movespeed_modifier/protean_starvation]"), "Removed refactory must release its starvation slowdown")
	qdel(stomach)

#undef PROTEAN_TEST_EPSILON

