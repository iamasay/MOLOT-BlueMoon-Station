	TEST_ASSERT(!(mod.movement_type & FLYING), "Arrival must remove temporary flight")
	TEST_ASSERT_EQUAL(get_turf(old_backpack), get_turf(user), "Delivery must leave the displaced backpack on the floor")

/datum/unit_test/mod_pathfinder_flight_cleanup/Run()
