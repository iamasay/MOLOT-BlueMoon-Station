	TEST_ASSERT(suit.relaymove(human, EAST), "Conscious Protean must move its suit along the ground")
	TEST_ASSERT_EQUAL(get_turf(suit), get_step(origin, EAST), "Mobile MOD must move one tile")
	TEST_ASSERT(!suit.relaymove(human, EAST), "Suit movement must respect its cooldown")
	COOLDOWN_RESET(suit, movement_cooldown)
	var/turf/wall = get_step(suit, EAST)
	var/old_type = wall.type
