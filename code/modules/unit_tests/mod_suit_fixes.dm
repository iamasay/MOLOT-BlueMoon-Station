		TEST_ASSERT(module.recall(user), "Recall must start before cancellation")
		var/datum/mod_pathfinder_flight/flight = module.flight
		var/obj/item/card/id/id = flight.id_card
		STOP_PROCESSING(SSfastprocess, flight)
		switch(ending)
			if("implant")
				qdel(module.implant)
			if("remove_implant")
				module.implant.removed(user)
			if("module")
				qdel(module)
			if("suit")
				qdel(mod)
			if("panel")
				mod.toggle_state(MOD_OPEN)
				flight.process(0.2)
			if("uninstall")
				mod.uninstall(module)
		TEST_ASSERT(QDELETED(flight) && QDELETED(id), "Every cancellation must delete flight and its owned access card")
		if(!QDELETED(mod))
			TEST_ASSERT(!(mod.movement_type & FLYING), "Cancelled recall must restore movement flags")
			TEST_ASSERT(mod.interaction_flags_item & INTERACT_ITEM_ATTACK_HAND_PICKUP, "Cancelled recall must restore pickup")
		qdel(mod)
		qdel(module)
