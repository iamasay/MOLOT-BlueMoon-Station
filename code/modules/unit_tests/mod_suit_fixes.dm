	implant.Remove(TRUE)
	TEST_ASSERT(QDELETED(program) && QDELETED(scryer) && QDELETED(cell), "NIF removal must clear software, terminal and its cell")
	TEST_ASSERT(!implant.linked_mob && !length(implant.loaded_nifsofts), "Removed NIF must release wearer and software references")

