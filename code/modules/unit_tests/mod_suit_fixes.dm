	mod.quick_activation()
	COOLDOWN_RESET(sonar, cooldown_current_timer)
	sonar.scan_creatures()
	pings = sonar.pings.Copy()
	qdel(sonar)
	for(var/obj/effect/temp_visual/mod_sonar_ping/ping as anything in pings)
		TEST_ASSERT(QDELETED(ping), "Deleting sonar must delete every remaining ping")

/datum/unit_test/mod_bulwark_protection/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/shove_blocker/bulwark = allocate(/obj/item/mod/module/shove_blocker)
	mod.install(bulwark)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	TEST_ASSERT(!human.is_shove_knockdown_blocked(), "Inactive bulwark must not block shoves")
	mod.quick_activation()
	TEST_ASSERT(human.is_shove_knockdown_blocked(), "Active bulwark must block shove knockdown")
	human.Stagger(1 SECONDS)
	TEST_ASSERT(!human.IsStaggered(), "Bulwark must prevent regular stagger")
	human.Stagger(1 SECONDS, ignore_canstun = TRUE)
	TEST_ASSERT(human.IsStaggered(), "Forced stagger must preserve its native bypass")
	human.SetStaggered(0)
	TEST_ASSERT(!human.IsStaggered(), "Bulwark must allow clearing stagger")
	var/obj/item/clothing/mod_part/chest = mod.get_chestplate()
	mod.conceal(human, chest, TRUE)
	TEST_ASSERT(!human.is_shove_knockdown_blocked(), "Retracting chestplate must remove shove protection")
	TEST_ASSERT(!HAS_TRAIT(human, TRAIT_NO_THROW_HITPUSH), "Retracting chestplate must remove thrown-item protection")
	human.Stagger(1 SECONDS)
	TEST_ASSERT(human.IsStaggered(), "Retracting chestplate must restore regular stagger")
	human.SetStaggered(0)
	mod.deploy(human, chest)
	TEST_ASSERT(human.is_shove_knockdown_blocked(), "Redeploying chestplate must restore protection")
	qdel(bulwark)
	TEST_ASSERT(!human.is_shove_knockdown_blocked(), "Deleting module must remove protection")
	TEST_ASSERT_NULL(bulwark.protected_user, "Deleting bulwark must release its wearer")

/datum/unit_test/mod_bulwark_thrown_push/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/shove_blocker/bulwark = allocate(/obj/item/mod/module/shove_blocker)
	var/obj/item/thrown_item = allocate(/obj/item/screwdriver)
	thrown_item.throwforce = 1
	thrown_item.dir = EAST
	mod.install(bulwark)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	var/turf/origin = get_turf(human)
	human.hitby(thrown_item, skipcatch = TRUE, hitpush = TRUE)
	TEST_ASSERT_EQUAL(get_turf(human), origin, "Active bulwark must block thrown-item push")
	mod.finish_activation(FALSE)
	human.hitby(thrown_item, skipcatch = TRUE, hitpush = TRUE)
	TEST_ASSERT_EQUAL(get_turf(human), get_step(origin, EAST), "Shutdown must restore native thrown-item push")

/datum/unit_test/mod_bulwark_preserves_sources/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	ADD_TRAIT(human, TRAIT_BRAWLING_KNOCKDOWN_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
	ADD_TRAIT(human, TRAIT_NO_THROW_HITPUSH, TRAIT_SOURCE_UNIT_TESTS)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/shove_blocker/bulwark = allocate(/obj/item/mod/module/shove_blocker)
	mod.install(bulwark)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	mod.quick_activation()
	qdel(mod)
	TEST_ASSERT(human.is_shove_knockdown_blocked(), "Cleanup must preserve independent shove protection")
	TEST_ASSERT(HAS_TRAIT_FROM(human, TRAIT_NO_THROW_HITPUSH, TRAIT_SOURCE_UNIT_TESTS), "Cleanup must preserve independent throw protection")
	TEST_ASSERT(!HAS_TRAIT_NOT_FROM(human, TRAIT_NO_THROW_HITPUSH, TRAIT_SOURCE_UNIT_TESTS), "Cleanup must remove all module-owned throw protection")
	REMOVE_TRAIT(human, TRAIT_BRAWLING_KNOCKDOWN_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
	REMOVE_TRAIT(human, TRAIT_NO_THROW_HITPUSH, TRAIT_SOURCE_UNIT_TESTS)

/datum/unit_test/mod_pepper_manual_and_reactive/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/pepper_shoulders/pepper = allocate(/obj/item/mod/module/pepper_shoulders)
	mod.install(pepper)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	TEST_ASSERT(!pepper.on_use(), "Inactive suit must not spray pepper")
	mod.quick_activation()
	STOP_PROCESSING(SSobj, mod)
	var/charge_before = mod.get_charge()
	TEST_ASSERT(pepper.on_use(), "Active deployed chestplate must spray pepper")
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - pepper.use_power_cost, "Spray must consume energy once")
	var/obj/effect/particle_effect/smoke/chem/smoke = locate() in get_turf(human)
	TEST_ASSERT_NOTNULL(smoke, "Pepper spray must create chemical smoke")
	TEST_ASSERT(smoke.reagents.has_reagent(/datum/reagent/consumable/condensedcapsaicin), "Smoke must contain condensed capsaicin")
	TEST_ASSERT(!pepper.on_use(), "Pepper spray must respect cooldown")
	TEST_ASSERT(pepper.overlay_state_inactive in icon_states(pepper.overlay_icon_file), "Pepper idle overlay must exist")
	TEST_ASSERT(pepper.overlay_state_use in icon_states(pepper.overlay_icon_file), "Pepper activation overlay must exist")
	COOLDOWN_RESET(pepper, cooldown_current_timer)
	charge_before = mod.get_charge()
	SEND_SIGNAL(human, COMSIG_LIVING_RUN_BLOCK, FALSE)
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before, "Virtual block checks must not trigger pepper spray")
	SEND_SIGNAL(human, COMSIG_LIVING_RUN_BLOCK, TRUE)
	sleep(world.tick_lag)
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before - pepper.use_power_cost, "Real attack must trigger pepper spray")
	COOLDOWN_RESET(pepper, cooldown_current_timer)
	mod.conceal(human, mod.get_chestplate(), TRUE)
	charge_before = mod.get_charge()
	SEND_SIGNAL(human, COMSIG_LIVING_RUN_BLOCK, TRUE)
	sleep(world.tick_lag)
	TEST_ASSERT_EQUAL(mod.get_charge(), charge_before, "Retracted chestplate must not spray pepper")
	qdel(pepper)
	TEST_ASSERT_NULL(pepper.pepper_user, "Deleted pepper module must release wearer")

/datum/unit_test/mod_hat_stabilizer_roundtrip/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
	var/obj/item/mod/module/hat_stabilizer/stabilizer = allocate(/obj/item/mod/module/hat_stabilizer)
	var/obj/item/clothing/head/beret/hat = allocate(/obj/item/clothing/head/beret)
	mod.install(stabilizer)
	human.equip_to_slot_if_possible(mod, ITEM_SLOT_BACK)
	var/obj/item/clothing/mod_part/helmet = mod.get_helmet()
	var/original_cover = helmet.flags_cover
	var/original_visor = helmet.visor_flags_cover
	hat.flags_cover = HEADCOVERSEYES
	human.put_in_active_hand(hat)
	TEST_ASSERT(stabilizer.attach_hat(hat, human), "Stabilizer must accept a held hat")
	TEST_ASSERT_EQUAL(hat.loc, helmet, "Attached hat must be held inside the helmet")
	TEST_ASSERT(helmet.flags_cover & HEADCOVERSEYES, "Attached hat must contribute its cover flags")
	var/list/overlays = helmet.worn_overlays()
	TEST_ASSERT(length(overlays), "Attached hat must contribute a worn overlay")
	mod.quick_activation()
	TEST_ASSERT_EQUAL(human.head, helmet, "Hat must not block helmet deployment")
	human.set_body_position(LYING_DOWN)
	TEST_ASSERT_EQUAL(stabilizer.attached_hat, hat, "Powered stabilizer must retain the hat when wearer falls")
	human.set_body_position(STANDING_UP)
	for(var/obj/item/clothing/mod_part/part as anything in mod.get_mod_parts(include_cell = FALSE))
		part.seal_part(FALSE)
	mod.finish_activation(FALSE)
	human.set_body_position(LYING_DOWN)
	TEST_ASSERT_NULL(stabilizer.attached_hat, "Unpowered stabilizer must release a loose hat on falling")
	TEST_ASSERT_EQUAL(get_turf(hat), get_turf(human), "Loose hat must fall to wearer's turf")
	TEST_ASSERT_EQUAL(helmet.flags_cover, original_cover, "Removing hat must restore unsealed cover flags")
	TEST_ASSERT_EQUAL(helmet.visor_flags_cover, original_visor, "Removing hat must preserve visor cover flags")
	human.set_body_position(STANDING_UP)
	human.put_in_active_hand(hat)
	TEST_ASSERT(stabilizer.attach_hat(hat, human), "Released hat must be reattachable")
	for(var/obj/item/clothing/mod_part/part as anything in mod.get_mod_parts(include_cell = FALSE))
		part.seal_part(TRUE)
	mod.finish_activation(TRUE)
	stabilizer.remove_hat(human)
	TEST_ASSERT_EQUAL(helmet.flags_cover, original_cover | original_visor, "Removing hat from sealed helmet must preserve native visor protection")
	TEST_ASSERT_EQUAL(stabilizer.attached_hat, null, "Removal must clear the attached hat reference")
	TEST_ASSERT(stabilizer.icon_state in icon_states(stabilizer.icon), "Stabilizer inventory sprite must exist")

/datum/unit_test/mod_hat_stabilizer_cleanup/Run()
	for(var/ending in list("uninstall", "module", "suit", "move", "hat"))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
		var/obj/item/mod/control/mod = allocate(/obj/item/mod/control/pre_equipped)
		var/obj/item/mod/module/hat_stabilizer/stabilizer = allocate(/obj/item/mod/module/hat_stabilizer)
